---
import Icon from "@/components/ui/Icon.astro";
import { pricing } from "@/config/pricing";
import Price from "./Price.astro";
---

<ul class="grid gap-4 lg:grid-cols-3 lg:items-stretch">
  {
    pricing.plans.map((plan, index) => (
      <li
        class:list={[
          "reveal relative flex flex-col overflow-hidden rounded-card p-7 sm:p-9",
          plan.featured ? "on-night pattern shadow-(--shadow-lift) lg:-my-4 lg:py-12" : "bg-surface shadow-[inset_0_0_0_1px_var(--line)]",
        ]}
        style={`--i:${index}`}
      >
        <div class="flex items-center justify-between gap-4">
          <h2 class="text-2xl font-medium tracking-tight">{plan.name}</h2>
          {plan.featured && <span class="rounded-full bg-spark px-3 py-1 text-xs font-semibold text-ink">Most popular</span>}
        </div>
        <p class="mt-3 min-h-12 text-muted">{plan.description}</p>
        <p class="mt-8 flex items-baseline gap-2">
          <Price plan={plan} class="text-6xl font-medium tracking-[-0.05em] tabular" />
          {plan.monthly !== null && (
            <span class="text-muted" data-billed>
              per month
            </span>
          )}
        </p>
        <a href={plan.cta.href} class:list={["btn mt-8 w-full", plan.featured ? "btn-spark" : "btn-primary"]}>
          {plan.cta.label}
          <Icon name="arrow-right" class="btn-arrow" stroke={2} />
        </a>
        <ul class:list={["mt-8 grid gap-3 border-t pt-8", plan.featured ? "border-night-line" : "border-line"]}>
          {plan.highlights.map((item) => (
            <li class="flex gap-3">
              <span class:list={["mt-0.5 grid size-5 shrink-0 place-items-center rounded-full", plan.featured ? "bg-spark text-ink" : "bg-brand-soft text-brand"]}>
                <Icon name="check" class="size-3" stroke={3} />
              </span>
              {item}
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>
