---
import { Image } from "astro:assets";
import Icon from "@/components/ui/Icon.astro";
import { formatDate, postHref, type Post } from "@/lib/posts";

interface Props {
  post: Post;
  variant?: "card" | "lead";
  headingLevel?: "h2" | "h3";
  eager?: boolean;
}

const { post, variant = "card", headingLevel = "h3", eager = false } = Astro.props;
const { title, description, cover, coverAlt, topic, date, author } = post.data;
const Heading = headingLevel;
const lead = variant === "lead";
---

<article
  class:list={[
    "post-card group relative flex h-full flex-col rounded-card bg-surface p-2 shadow-[inset_0_0_0_1px_var(--line)] transition-shadow hover:shadow-(--shadow-lift)",
    lead && "gap-2 lg:grid lg:grid-cols-12 lg:items-center lg:gap-6",
  ]}
>
  <div class:list={["overflow-hidden rounded-panel bg-sunken", lead ? "aspect-16/10 lg:col-span-7" : "aspect-16/10"]}>
    <Image
      src={cover}
      alt={coverAlt}
      widths={lead ? [640, 960, 1400] : [480, 720, 960]}
      sizes={lead ? "(min-width: 1024px) 50vw, 100vw" : "(min-width: 1024px) 26rem, (min-width: 640px) 50vw, 100vw"}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      class="post-cover size-full object-cover"
    />
  </div>
  <div class:list={["flex flex-1 flex-col", lead ? "p-4 sm:p-6 lg:col-span-5 lg:pr-10" : "p-4 pt-5"]}>
    <p class="meta flex flex-wrap items-center gap-x-2.5">
      <span class="rounded-full bg-brand-soft px-2.5 py-0.5 text-brand-ink">{topic}</span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </p>
    <Heading
      class:list={[
        "mt-4 tracking-tight transition-colors group-hover:text-brand",
        lead ? "text-display-md" : "text-xl leading-snug font-medium",
      ]}
    >
      <a href={postHref(post)} class="after:absolute after:inset-0 after:rounded-card">{title}</a>
    </Heading>
    <p class:list={["mt-3 text-muted", lead ? "text-lead" : "line-clamp-3"]}>{description}</p>
    {
      lead && (
        <p class="mt-6 flex items-center gap-2 text-sm font-medium">
          By {author}
          <Icon name="arrow-right" class="btn-arrow text-brand" stroke={2} />
        </p>
      )
    }
  </div>
</article>

<style>
  .post-cover {
    transition: transform 0.9s var(--ease-out-expo);
  }

  .post-card:hover .post-cover {
    transform: scale(1.04);
  }

  .post-card:has(a:focus-visible) {
    outline: 2px solid var(--brand);
    outline-offset: 4px;
  }

  .post-card a:focus-visible {
    outline: none;
  }
</style>
