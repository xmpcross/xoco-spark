---
import TopicNav from "@/components/blog/TopicNav.astro";
import Accent from "@/components/ui/Accent.astro";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  title: string;
  description: string;
  topic?: string;
}

const { title, description, topic } = Astro.props;
---

<header class="pattern -mt-(--header-h) pt-[calc(var(--header-h)+3rem)] pb-12 sm:pt-[calc(var(--header-h)+5rem)] lg:pb-14">
  <div class="shell text-center">
    <h1 class="rise text-display-xl" style="--i:1"><Accent text={title} /></h1>
    <p class="rise mx-auto mt-5 max-w-xl text-lead text-muted" style="--i:2">{description}</p>
    <div class="rise mt-10 flex flex-col items-center gap-4" style="--i:3">
      <button
        type="button"
        class="flex h-12 w-full max-w-md items-center gap-3 rounded-full bg-surface px-5 text-[0.9375rem] text-muted shadow-[inset_0_0_0_1px_var(--line)] transition-shadow hover:text-ink hover:shadow-[inset_0_0_0_1px_var(--brand)]"
        data-search-open
      >
        <Icon name="search" class="size-4" />
        <span class="flex-1 text-left">Search posts</span>
        <kbd class="rounded-md bg-page px-1.5 py-0.5 font-sans text-xs font-medium shadow-[inset_0_0_0_1px_var(--line)]">⌘K</kbd>
      </button>
      <TopicNav current={topic} />
    </div>
  </div>
</header>
