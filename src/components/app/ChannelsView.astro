---
import Avatar from "@/components/app/Avatar.astro";
import Pill from "@/components/app/Pill.astro";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const channels = [
  { name: "Chat", icon: "message-circle", tile: "bg-brand", value: "1,842", delta: "+12%", trend: [18, 22, 20, 27, 25, 31, 36] },
  { name: "Email", icon: "mail", tile: "bg-[#2d8cff]", value: "964", delta: "+4%", trend: [20, 19, 23, 21, 24, 23, 26] },
  { name: "Voice", icon: "phone", tile: "bg-ink", value: "418", delta: "+31%", trend: [8, 10, 9, 14, 17, 19, 24] },
  { name: "WhatsApp", icon: "social-whatsapp", tile: "bg-[#25d366]", value: "327", delta: "+18%", trend: [10, 12, 11, 15, 14, 18, 21] },
];

type Channel = "chat" | "email" | "whatsapp" | "voice";
type Tone = "good" | "brand" | "warn" | "neutral";
const live: { name: string; channel: Channel; topic: string; playbook: string; status: string; tone: Tone; time: string; working?: boolean }[] = [
  { name: "Maya Chen", channel: "chat", topic: "Vase arrived cracked", playbook: "Damaged item refund", status: "Resolved", tone: "good", time: "1:48" },
  { name: "James Osei", channel: "whatsapp", topic: "Change delivery slot", playbook: "Delivery changes", status: "Rebooking", tone: "brand", time: "0:42", working: true },
  { name: "Lucía Pérez", channel: "email", topic: "Duplicate charge", playbook: "Billing disputes", status: "Refunded", tone: "good", time: "2:05" },
  { name: "Aiko Nakamura", channel: "chat", topic: "Account locked", playbook: "Account access", status: "Verifying", tone: "brand", time: "1:12", working: true },
  { name: "Tom Keller", channel: "voice", topic: "Insurance claim", playbook: "Hand-offs", status: "With Ana", tone: "warn", time: "4:30" },
  { name: "Rohan Bhatt", channel: "email", topic: "Annual plan upgrade", playbook: "Plan changes", status: "Upgraded", tone: "good", time: "3:40" },
];

/* Points for a 64x20 sparkline. */
const spark = (values: number[]) => {
  const max = Math.max(...values);
  const min = Math.min(...values);
  return values.map((v, i) => `${(i / (values.length - 1)) * 64},${18 - ((v - min) / (max - min)) * 16}`).join(" ");
};
---

<div class:list={["channels flex w-full flex-col text-[0.8125rem] leading-snug", className]}>
  <div class="flex h-13 shrink-0 items-center gap-2 border-b border-line px-4">
    <span class="font-semibold">Channels</span>
    <span class="status hidden"><Pill tone="good">All systems normal</Pill></span>
    <span class="ml-auto inline-flex items-center gap-1 rounded-lg bg-ink px-2.5 py-1 text-[0.6875rem] font-semibold text-white"><Icon name="plus" class="size-3" stroke={2.5} />Add channel</span>
  </div>

  <div class="min-h-0 flex-1 overflow-hidden bg-[color-mix(in_srgb,var(--page)_55%,var(--surface))] p-3 sm:p-4">
    <ul class="cards grid gap-2">
      {
        channels.map((channel) => (
          <li class="rounded-xl bg-surface p-3 shadow-[inset_0_0_0_1px_var(--line),0_1px_2px_rgb(12_12_29/0.04)]">
            <p class="flex items-center gap-2">
              <span class:list={["grid size-6 place-items-center rounded-md text-white", channel.tile]}>
                <Icon name={channel.icon} class="size-3.5" stroke={2} />
              </span>
              <span class="font-medium">{channel.name}</span>
              <span class="toggle ml-auto" />
            </p>
            <p class="mt-3 flex items-end justify-between gap-2">
              <span>
                <span class="block text-[1.25rem] leading-none font-semibold tracking-[-0.03em] tabular">{channel.value}</span>
                <span class="mt-1 block text-[0.6875rem] text-muted">
                  today <span class="font-medium text-good">{channel.delta}</span>
                </span>
              </span>
              <svg viewBox="0 0 64 20" class="spark h-5 w-14 overflow-visible" aria-hidden="true">
                <polyline points={spark(channel.trend)} fill="none" stroke="var(--brand)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
              </svg>
            </p>
          </li>
        ))
      }
    </ul>

    <div class="mt-3 overflow-hidden rounded-xl bg-surface shadow-[inset_0_0_0_1px_var(--line),0_1px_2px_rgb(12_12_29/0.04)]">
      <p class="flex items-center gap-2 border-b border-line px-3 py-2.5">
        <span class="relative flex size-2">
          <span class="ping absolute inset-0 rounded-full bg-good"></span>
          <span class="relative size-2 rounded-full bg-good"></span>
        </span>
        <span class="font-semibold">Live now</span>
        <span class="text-muted">38 conversations</span>
        <Icon name="list-filter" class="ml-auto size-3.5 text-muted" />
      </p>
      <ul>
        {
          live.map((row) => (
            <li class="row grid items-center gap-3 border-b border-line px-3 py-2 last:border-0">
              <span class="flex min-w-0 items-center gap-2.5">
                <Avatar name={row.name} channel={row.channel} class="size-7" />
                <span class="min-w-0 leading-tight">
                  <span class="block truncate font-medium">{row.name}</span>
                  <span class="topic-sub block truncate text-[0.6875rem] text-muted">{row.topic}</span>
                </span>
              </span>
              <span class="topic hidden truncate text-muted">{row.topic}</span>
              <span class="playbook hidden truncate text-[0.75rem] text-muted">
                <Icon name="workflow" class="mr-1 size-3 align-[-0.125em]" />
                {row.playbook}
              </span>
              <Pill tone={row.tone} live={row.working} class="justify-self-start">
                {row.status}
              </Pill>
              <span class="time hidden text-right text-[0.75rem] text-muted tabular">{row.time}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<style>
  .channels {
    container-type: inline-size;
  }

  .cards {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .toggle {
    position: relative;
    width: 1.625rem;
    height: 0.95rem;
    border-radius: 999px;
    background: var(--good);
  }

  .toggle::after {
    content: "";
    position: absolute;
    top: 0.125rem;
    right: 0.125rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.2);
  }

  .row {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ping {
      animation: ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @container (min-width: 34rem) {
    .status {
      display: inline-flex;
    }

    .row {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) 6.5rem 3rem;
    }

    .topic,
    .time {
      display: block;
    }

    .topic-sub {
      display: none;
    }
  }

  @container (min-width: 46rem) {
    .cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .row {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 1fr) 6.5rem 3rem;
    }

    .playbook {
      display: block;
    }
  }
</style>
