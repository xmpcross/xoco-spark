---
import { Image } from "astro:assets";
import AppRail from "@/components/app/AppRail.astro";
import Avatar from "@/components/app/Avatar.astro";
import BrandMark from "@/components/app/BrandMark.astro";
import Pill from "@/components/app/Pill.astro";
import Icon from "@/components/ui/Icon.astro";
import Logomark from "@/components/ui/Logomark.astro";
import { attachment } from "@/config/demo";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

type Channel = "chat" | "email" | "whatsapp" | "voice";
type Tone = "good" | "brand" | "warn" | "neutral";
const conversations: { name: string; channel: Channel; time: string; preview: string; status: string; tone: Tone; live?: boolean }[] = [
  { name: "Maya Chen", channel: "chat", time: "2m", preview: "That was fast, thank you so much!", status: "Resolved", tone: "good" },
  { name: "James Osei", channel: "whatsapp", time: "4m", preview: "Can I move my delivery to Saturday?", status: "Rebooking", tone: "brand", live: true },
  { name: "Lucía Pérez", channel: "email", time: "7m", preview: "Me cobraron dos veces la suscripción", status: "Refunded", tone: "good" },
  { name: "Aiko Nakamura", channel: "chat", time: "12m", preview: "The reset link says it expired", status: "Verifying", tone: "brand", live: true },
  { name: "Tom Keller", channel: "voice", time: "18m", preview: "Water damage claim, kitchen floor", status: "With Ana", tone: "warn" },
  { name: "Rohan Bhatt", channel: "email", time: "25m", preview: "Can I switch to the annual plan?", status: "Upgraded", tone: "good" },
];

const checks: { mark?: string; icon?: string; label: string; detail: string }[] = [
  { mark: "shopify", label: "Order #48213 found", detail: "Delivered Oct 2" },
  { icon: "image", label: "Damage visible in photo", detail: "High confidence" },
  { icon: "book-open", label: "Refund policy", detail: "Under €200 limit" },
];

const steps = ["Verify customer", "Find the order", "Check the photo", "Refund under €200", "Confirm and close"];
---

<div class:list={["inbox w-full text-[0.8125rem] leading-snug", className]}>
  <div class="flex h-full min-h-0">
    <div class="rail-col hidden">
      <AppRail active="inbox" />
    </div>

    <div class="list-col hidden w-68 shrink-0 flex-col border-r border-line">
      <div class="px-4 pt-4">
        <p class="flex items-center gap-2">
          <span class="text-[0.9375rem] font-semibold tracking-[-0.01em]">Inbox</span>
          <span class="text-[0.75rem] text-muted tabular">248</span>
          <Icon name="square-pen" class="ml-auto size-4 text-muted" />
        </p>
        <div class="mt-3 grid grid-cols-3 gap-0.5 rounded-lg bg-page p-0.5 text-center text-[0.6875rem] font-medium text-muted shadow-[inset_0_0_0_1px_var(--line)]">
          <span class="rounded-md bg-surface py-1 text-ink shadow-[0_1px_2px_rgb(12_12_29/0.08),0_0_0_1px_rgb(12_12_29/0.04)]">All</span>
          <span class="py-1">Spark</span>
          <span class="flex items-center justify-center gap-1 py-1">Needs you <span class="rounded-full bg-warn-soft px-1 text-[0.5625rem] leading-[0.9rem] font-semibold text-warn">1</span></span>
        </div>
      </div>
      <ul class="mt-2 grid gap-0.5 overflow-hidden px-2 pb-2">
        {
          conversations.map((item, index) => (
            <li class:list={["flex gap-2.5 rounded-xl py-2.5 pr-4 pl-2.5", index === 0 && "bg-brand-wash shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--brand)_14%,transparent)]"]}>
              <Avatar name={item.name} channel={item.channel} class="size-9" />
              <span class="min-w-0 flex-1">
                <span class="flex items-baseline gap-2">
                  <span class="truncate font-semibold">{item.name}</span>
                  <span class="ml-auto shrink-0 text-[0.625rem] text-muted tabular">{item.time}</span>
                </span>
                <span class="mt-0.5 block truncate text-[0.75rem] text-muted">{item.preview}</span>
                <span class="mt-1.5 flex">
                  <Pill tone={item.tone} live={item.live}>
                    {item.status}
                  </Pill>
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="thread-col flex min-w-0 flex-1 flex-col bg-[color-mix(in_srgb,var(--page)_55%,var(--surface))]">
      <div class="flex h-14 shrink-0 items-center gap-2.5 border-b border-line bg-surface px-4">
        <Icon name="chevron-left" class="back -ml-1 size-4 text-muted" />
        <Avatar name="Maya Chen" channel="chat" class="size-8" />
        <span class="min-w-0 leading-tight">
          <span class="block truncate font-semibold">Maya Chen</span>
          <span class="block truncate text-[0.6875rem] text-muted">Order #48213 · Web chat</span>
        </span>
        <Pill tone="good" class="ml-auto">Resolved</Pill>
        <Icon name="ellipsis-vertical" class="size-4 text-muted" />
      </div>

      <div class="messages flex min-h-0 flex-1 flex-col justify-end gap-2.5 overflow-hidden px-4 pt-6 pb-3">
        <p class="msg flex items-center gap-3 text-[0.625rem] font-medium text-muted" style="--m:0">
          <span class="h-px flex-1 bg-line"></span>Today, 10:41<span class="h-px flex-1 bg-line"></span>
        </p>

        <div class="msg flex max-w-[86%] items-end gap-2" style="--m:1">
          <Avatar name="Maya Chen" class="size-6" />
          <span class="grid justify-items-start gap-1">
            <Image src={attachment.photo} alt="" widths={[200, 400]} sizes="10rem" class="aspect-4/3 w-36 rounded-2xl object-cover shadow-[0_0_0_1px_var(--line)]" />
            <p class="rounded-2xl rounded-bl-md bg-surface px-3 py-2 shadow-[inset_0_0_0_1px_var(--line)]">Hi! My vase arrived cracked this morning. Can I get a refund?</p>
          </span>
        </div>

        <span class="msg -mb-1.5 ml-auto flex items-center gap-1.5 text-[0.625rem] font-medium text-muted" style="--m:2"><Logomark class="size-4" />Spark · AI agent</span>

        <div class="msg ml-auto w-[min(100%,19rem)] overflow-hidden rounded-2xl bg-surface shadow-[0_0_0_1px_var(--line),0_6px_16px_-10px_rgb(12_12_29/0.25)]" style="--m:3">
          <p class="flex items-center gap-1.5 border-b border-line px-3 py-2 text-[0.6875rem] font-semibold">
            <Icon name="sparkles" class="size-3.5 text-brand" />
            Damaged item refund
            <span class="ml-auto font-medium text-muted tabular">0.6s</span>
          </p>
          <ul class="checks gap-1.5 px-3 py-2.5 text-[0.6875rem]">
            {
              checks.map((check) => (
                <li class="flex items-center gap-2">
                  {check.mark ? <BrandMark name={check.mark} class="size-4.5" /> : <span class="grid size-4.5 place-items-center rounded-[28%] bg-page text-muted shadow-[inset_0_0_0_1px_var(--line)]"><Icon name={check.icon ?? "check"} class="size-3" /></span>}
                  <span class="truncate font-medium">{check.label}</span>
                  <span class="ml-auto truncate text-muted">{check.detail}</span>
                  <Icon name="check" class="size-3.5 text-good" stroke={2.5} />
                </li>
              ))
            }
          </ul>
          <div class="flex items-center gap-2.5 bg-brand-wash px-3 py-2.5">
            <BrandMark name="stripe" class="size-7" />
            <span class="min-w-0 leading-tight">
              <span class="block text-[0.75rem] font-semibold">Refund issued</span>
              <span class="block truncate text-[0.625rem] text-muted">Visa •••• 4821 · re_3PkL2</span>
            </span>
            <span class="ml-auto text-[0.875rem] font-semibold tracking-[-0.02em] tabular">€64.00</span>
          </div>
        </div>

        <div class="msg ml-auto flex max-w-[86%] flex-col items-end gap-1" style="--m:4">
          <p class="bubble-out rounded-2xl rounded-br-md px-3 py-2 text-white">So sorry, Maya! I've refunded €64.00 to your Visa ending 4821. No need to send the vase back.</p>
        </div>

        <div class="msg flex max-w-[86%] items-end gap-2" style="--m:5">
          <Avatar name="Maya Chen" class="size-6" />
          <p class="rounded-2xl rounded-bl-md bg-surface px-3 py-2 shadow-[inset_0_0_0_1px_var(--line)]">That was fast, thank you so much!</p>
        </div>

        <p class="msg flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-[0.6875rem] text-muted" style="--m:6">
          <span class="inline-flex items-center gap-1 font-medium text-good"><Icon name="circle-check" class="size-3.5" stroke={2} />Resolved by Spark in 1m 48s</span>
          <span class="inline-flex items-center gap-0.5 text-[#f5a524]">
            {[1, 2, 3, 4, 5].map(() => <Icon name="star" class="size-3 [&_path]:fill-current" />)}
          </span>
        </p>
      </div>

      <div class="shrink-0 px-3 pb-3">
        <div class="rounded-xl bg-surface p-2 shadow-[0_0_0_1px_var(--line),0_2px_6px_-2px_rgb(12_12_29/0.08)]">
          <p class="flex items-center gap-2 px-1 pt-0.5 text-[0.75rem] text-muted">
            <span class="grid size-5 place-items-center rounded-full bg-brand-soft text-brand"><Icon name="sparkles" class="size-3" /></span>
            Spark is handling this conversation
          </p>
          <p class="mt-2 flex items-center gap-2.5 px-1 text-muted">
            <Icon name="paperclip" class="size-3.5" />
            <Icon name="smile" class="size-3.5" />
            <Icon name="book-open" class="size-3.5" />
            <span class="ml-auto rounded-lg bg-ink px-2.5 py-1 text-[0.6875rem] font-semibold text-white">Take over</span>
          </p>
        </div>
      </div>
    </div>

    <div class="details-col hidden w-66 shrink-0 flex-col overflow-hidden border-l border-line">
      <div class="border-b border-line p-4">
        <p class="flex items-center gap-2.5">
          <Avatar name="Maya Chen" class="size-10" />
          <span class="min-w-0 leading-tight">
            <span class="block font-semibold">Maya Chen</span>
            <span class="block truncate text-[0.6875rem] text-muted">maya.chen@fastmail.com</span>
          </span>
        </p>
        <dl class="mt-3.5 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1.5 text-[0.75rem]">
          <dt class="text-muted">Location</dt>
          <dd class="text-right">Lisbon, PT</dd>
          <dt class="text-muted">Lifetime value</dt>
          <dd class="text-right tabular">€1,240</dd>
          <dt class="text-muted">Tier</dt>
          <dd class="text-right"><span class="rounded-md bg-[#fdf3d7] px-1.5 py-px text-[0.6875rem] font-semibold text-[#8a6100]">Gold</span></dd>
        </dl>
      </div>

      <div class="border-b border-line p-4">
        <p class="flex items-center gap-2">
          <BrandMark name="shopify" class="size-6" />
          <span class="font-semibold">Order #48213</span>
          <Pill tone="good" class="ml-auto">Refunded</Pill>
        </p>
        <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1.5 text-[0.75rem]">
          <dt class="text-muted">Item</dt>
          <dd class="truncate text-right">Ceramic vase, sand</dd>
          <dt class="text-muted">Total</dt>
          <dd class="text-right tabular">€64.00</dd>
          <dt class="text-muted">Delivered</dt>
          <dd class="text-right">Oct 2 · DHL</dd>
        </dl>
      </div>

      <div class="border-b border-line p-4">
        <p class="text-[0.625rem] font-semibold tracking-[0.06em] text-muted uppercase">Playbook</p>
        <p class="mt-1 font-semibold">Damaged item refund</p>
        <ol class="steps mt-3 grid gap-2 text-[0.75rem]">
          {
            steps.map((step) => (
              <li class="relative flex items-center gap-2.5">
                <span class="grid size-4 place-items-center rounded-full bg-good text-white">
                  <Icon name="check" class="size-2.5" stroke={3.5} />
                </span>
                {step}
              </li>
            ))
          }
        </ol>
      </div>

      <div class="p-4">
        <p class="flex items-baseline gap-1">
          <span class="text-[0.625rem] font-semibold tracking-[0.06em] text-muted uppercase">Quality score</span>
          <span class="ml-auto text-[1.25rem] font-semibold tracking-[-0.03em] text-brand tabular">98</span>
          <span class="text-[0.6875rem] text-muted">/ 100</span>
        </p>
        <span class="mt-2 block h-1.5 overflow-hidden rounded-full bg-sunken"><span class="bar block h-full w-[98%] rounded-full bg-brand"></span></span>
        <p class="mt-2.5 flex flex-wrap gap-1">
          {["Accurate", "On policy", "On brand"].map((tag) => <span class="rounded-md bg-page px-1.5 py-px text-[0.625rem] font-medium text-muted shadow-[inset_0_0_0_1px_var(--line)]">{tag}</span>)}
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  .inbox {
    container-type: inline-size;
  }

  .msg {
    flex-shrink: 0;
  }

  .bubble-out {
    background: var(--brand);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14);
  }

  .messages {
    mask-image: linear-gradient(transparent, #000 2.5rem);
  }

  .steps li + li::before {
    content: "";
    position: absolute;
    left: calc(0.5rem - 0.5px);
    bottom: 100%;
    width: 1px;
    height: 0.5rem;
    background: color-mix(in srgb, var(--good) 40%, transparent);
  }

  .checks {
    display: none;
  }

  @container (min-width: 30rem) {
    .checks {
      display: grid;
    }
  }

  @container (min-width: 42rem) {
    .list-col {
      display: flex;
    }

    .thread-col :global(.back) {
      display: none;
    }
  }

  @container (min-width: 58rem) {
    .details-col {
      display: flex;
    }
  }

  @container (min-width: 64rem) {
    .rail-col {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .msg {
      animation: msg-in 0.7s var(--ease-out-expo) both;
      animation-delay: calc(var(--m) * 160ms + 700ms);
    }

    .bar {
      animation: grow 1.4s var(--ease-out-expo) 1.2s both;
    }
  }

  @keyframes msg-in {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }

  @keyframes grow {
    from {
      width: 0;
    }
  }
</style>
