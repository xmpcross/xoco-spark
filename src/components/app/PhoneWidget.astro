---
import Icon from "@/components/ui/Icon.astro";
import Logomark from "@/components/ui/Logomark.astro";
import Wordmark from "@/components/ui/Wordmark.astro";
import { workspace } from "@/config/demo";

interface Props {
  /** Describes the widget for screen readers; without it the phone is decorative. */
  label?: string;
  /** Sets the width; everything inside scales with it. */
  class?: string;
}

const { label, class: className = "w-64" } = Astro.props;
---

<div class:list={["phone select-none", className]} role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"}>
  <div class="device">
    <div class="screen">
      <div class="status">
        <span>9:41</span>
        <span class="island"></span>
        <span class="status-icons">
          <svg viewBox="0 0 18 12" fill="currentColor"><rect x="0" y="8" width="3" height="4" rx="1"></rect><rect x="5" y="5.5" width="3" height="6.5" rx="1"></rect><rect x="10" y="3" width="3" height="9" rx="1"></rect><rect x="15" y="0" width="3" height="12" rx="1"></rect></svg>
          <svg viewBox="0 0 26 12" fill="none"><rect x="0.5" y="0.5" width="22" height="11" rx="3.5" stroke="currentColor" opacity=".4"></rect><rect x="2" y="2" width="17" height="8" rx="2" fill="currentColor"></rect><rect x="24" y="4" width="1.5" height="4" rx=".75" fill="currentColor" opacity=".45"></rect></svg>
        </span>
      </div>

      <div class="head">
        <Logomark class="brand" />
        <span class="who">
          <span class="name">{workspace.name} support</span>
          <span class="online"><span class="online-dot"></span>Replies instantly</span>
        </span>
        <Icon name="x" class="close" />
      </div>

      <div class="body">
        <p class="bubble in" style="--m:0">Hi Jamie, how can we help today?</p>
        <p class="bubble out" style="--m:1">I want to pause my plan while I travel</p>
        <p class="bubble in" style="--m:2">Of course. Your Pro plan renews on Oct 12. How long should I pause it for?</p>
        <p class="replies" style="--m:3">
          <span>1 month</span><span class="picked">2 months</span><span>3 months</span>
        </p>
        <p class="bubble out" style="--m:4">2 months please</p>
        <div class="card" style="--m:5">
          <p class="card-title">
            <span class="tick"><Icon name="check" class="size-full" stroke={3} /></span>
            Plan paused
          </p>
          <p class="row"><span>Resumes</span><span>Dec 12, 2026</span></p>
          <p class="row"><span>Next charge</span><span>€0.00</span></p>
        </div>
        <p class="bubble in" style="--m:6">All set, Jamie. Enjoy your trip!</p>
      </div>

      <div class="foot">
        <p class="composer">
          Write a message…
          <span class="send"><Icon name="arrow-up" class="size-full" stroke={2.5} /></span>
        </p>
        <p class="powered">Powered by <Wordmark class="powered-mark" /></p>
      </div>
    </div>
  </div>
</div>

<style>
  .phone {
    container-type: inline-size;
  }

  /* Every size below is in em, so the whole phone scales with its width. */
  .device {
    font-size: calc(100cqw / 24);
    line-height: 1.35;
    padding: 0.55em;
    border-radius: 3.1em;
    background: #16152a;
    box-shadow:
      inset 0 0 0 0.12em #34334f,
      0 2.5em 4em -1.5em rgb(8 6 40 / 0.55);
    color: var(--ink);
  }

  .screen {
    display: flex;
    flex-direction: column;
    aspect-ratio: 9 / 19;
    overflow: hidden;
    border-radius: 2.6em;
    background: var(--page);
  }

  .status {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0.85em 1.6em 0.3em;
    background: var(--surface);
    font-size: 0.95em;
    font-weight: 600;
  }

  .island {
    width: 6.4em;
    height: 1.9em;
    border-radius: 999px;
    background: #16152a;
  }

  .status-icons {
    display: flex;
    justify-self: end;
    align-items: center;
    gap: 0.35em;
  }

  .status-icons svg:first-child {
    height: 0.7em;
  }

  .status-icons svg:last-child {
    height: 0.8em;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 0.75em;
    padding: 0.9em 1.2em 1em;
    background: var(--surface);
    box-shadow: 0 1px 0 var(--line);
  }

  .head :global(.brand) {
    width: 2.6em;
    height: 2.6em;
    border-radius: 0.8em;
    box-shadow:
      inset 0 0 0 1px var(--line),
      0 1px 2px rgb(12 12 29 / 0.06);
  }

  .who {
    min-width: 0;
    line-height: 1.25;
  }

  .name {
    display: block;
    font-size: 1.05em;
    font-weight: 600;
  }

  .online {
    display: flex;
    align-items: center;
    gap: 0.35em;
    font-size: 0.85em;
    color: var(--good);
  }

  .online-dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 999px;
    background: currentColor;
  }

  .head :global(.close) {
    width: 1.1em;
    height: 1.1em;
    margin-left: auto;
    color: var(--muted);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.6em;
    padding: 1.2em 1.1em;
    font-size: 0.95em;
  }

  .bubble {
    max-width: 82%;
    padding: 0.6em 0.9em;
    border-radius: 1.2em;
  }

  .in {
    align-self: flex-start;
    border-bottom-left-radius: 0.35em;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .out {
    align-self: flex-end;
    border-bottom-right-radius: 0.35em;
    background: var(--brand);
    color: #fff;
  }

  .replies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
  }

  .replies span {
    padding: 0.3em 0.75em;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand) 30%, var(--line));
    color: var(--brand-ink);
    font-size: 0.92em;
    font-weight: 500;
  }

  .replies .picked {
    background: var(--brand-soft);
  }

  .card {
    padding: 0.85em 1em;
    border-radius: 1.1em;
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      0 0.4em 1em -0.6em rgb(12 12 29 / 0.25);
  }

  .card-title {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-bottom: 0.5em;
    font-weight: 600;
  }

  .tick {
    display: grid;
    place-items: center;
    width: 1.35em;
    height: 1.35em;
    padding: 0.28em;
    border-radius: 999px;
    background: var(--good);
    color: #fff;
  }

  .row {
    display: flex;
    justify-content: space-between;
    padding-top: 0.25em;
    font-size: 0.92em;
  }

  .row span:first-child {
    color: var(--muted);
  }

  .row span:last-child {
    font-variant-numeric: tabular-nums;
  }

  .foot {
    padding: 0 1.1em 1.1em;
  }

  .composer {
    display: flex;
    align-items: center;
    padding: 0.35em 0.35em 0.35em 1.1em;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--muted);
  }

  .send {
    display: grid;
    place-items: center;
    width: 2.2em;
    height: 2.2em;
    padding: 0.55em;
    margin-left: auto;
    border-radius: 999px;
    background: var(--brand);
    color: #fff;
  }

  .powered {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
    margin-top: 0.7em;
    font-size: 0.78em;
    color: var(--muted);
  }

  .powered :global(.powered-mark) {
    height: 1.1em;
    width: auto;
    color: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .body > * {
      animation: msg-in 0.7s var(--ease-out-expo) both;
      animation-delay: calc(var(--m) * 160ms + 900ms);
    }
  }

  @keyframes msg-in {
    from {
      opacity: 0;
      translate: 0 0.5em;
    }
  }
</style>
