---
import Accent from "@/components/ui/Accent.astro";
import Icon from "@/components/ui/Icon.astro";
import { security } from "@/config/home";
---

<section id={security.id} class="on-night pattern py-20 sm:py-28" aria-labelledby="security-title">
  <div class="shell">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-end">
      <div class="reveal lg:col-span-7">
        <h2 id="security-title" class="text-display-lg"><Accent text={security.title} /></h2>
        <p class="mt-5 max-w-xl text-lead text-night-muted">{security.lead}</p>
      </div>
      <ul class="reveal flex flex-wrap gap-3 lg:col-span-5 lg:justify-end" aria-label="Certifications">
        {
          security.badges.map((badge) => (
            <li class="seal grid size-24 place-items-center content-center rounded-full text-center">
              <span class="text-lg leading-none font-semibold">{badge.name}</span>
              <span class="mt-1 text-xs text-night-muted">{badge.note}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        security.features.map((feature, index) => (
          <li class="card reveal p-7" style={`--i:${index}`}>
            <span class="grid size-11 place-items-center rounded-xl bg-spark/10 text-spark">
              <Icon name={feature.icon} class="size-5" />
            </span>
            <h3 class="mt-6 text-xl tracking-tight">{feature.title}</h3>
            <p class="mt-2 text-night-muted">{feature.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .seal {
    background: rgb(255 255 255 / 0.05);
    box-shadow:
      inset 0 0 0 1px var(--night-line),
      inset 0 0 0 6px rgb(255 255 255 / 0.02);
  }
</style>
