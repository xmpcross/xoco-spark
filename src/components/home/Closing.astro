---
import PhoneWidget from "@/components/app/PhoneWidget.astro";
import Accent from "@/components/ui/Accent.astro";
import Icon from "@/components/ui/Icon.astro";
import { closing, hero } from "@/config/home";
import { siteConfig } from "@/config/site";

const { primary, secondary } = siteConfig.actions;
---

<section class="pt-8 pb-20 sm:pb-28" aria-labelledby="closing-title">
  <div class="shell">
    <div class="closing on-night pattern reveal relative grid overflow-hidden rounded-4xl [--glow:80%_90%_at_85%_10%] lg:min-h-143 lg:grid-cols-12">
      <div class="relative px-6 py-14 sm:px-12 sm:py-20 lg:col-span-7 lg:self-center lg:py-24 lg:pl-16">
        <h2 id="closing-title" class="text-display-lg"><Accent text={closing.title} /></h2>
        <p class="mt-6 max-w-lg text-lead text-night-muted">{closing.lead}</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={primary.href} class="btn btn-spark">
            {primary.label}
            <Icon name="arrow-right" class="btn-arrow" stroke={2} />
          </a>
          <a href={secondary.href} class="btn btn-ghost">{secondary.label}</a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm text-night-muted">
          {
            hero.notes.map((note) => (
              <li class="inline-flex items-center gap-1.5">
                <Icon name="circle-check" class="size-4 text-spark" />
                {note}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="relative hidden lg:col-span-5 lg:block">
        <PhoneWidget class="absolute top-10 right-16 w-80 xl:right-24" />
      </div>
    </div>
  </div>
</section>

