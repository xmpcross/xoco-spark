---
import Icon from "@/components/ui/Icon.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import { siteConfig } from "@/config/site";
import { workflows } from "@/config/home";

const { primary } = siteConfig.actions;
/* Grid areas in reading order: card, chip, card, chip, card, chip, card. */
const areas = ["n0", "c0", "n1", "c1", "n2", "c2", "n3"];
---

<section id={workflows.id} class="py-20 sm:py-28" aria-labelledby="workflows-title">
  <div class="shell">
    <SectionHead id="workflows-title" title={workflows.title} lead={workflows.lead} />

    <div class="card reveal mt-14 grid gap-2 rounded-4xl p-2 lg:grid-cols-[minmax(0,21rem)_minmax(0,1fr)]" data-workflows>
      <div class="p-4 sm:p-6 lg:py-8" role="tablist" aria-orientation="vertical" aria-label="Playbooks">
        {
          workflows.items.map((item, index) => (
            <button
              type="button"
              role="tab"
              id={`wf-tab-${item.id}`}
              aria-controls={`wf-panel-${item.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              aria-labelledby={`wf-label-${item.id}`}
              aria-describedby={`wf-body-${item.id}`}
              tabindex={index === 0 ? 0 : -1}
              class="wf-tab group block w-full text-left"
              data-tab
            >
              <span class="flex items-center gap-3.5 py-3.5">
                <span class="wf-icon grid size-10 shrink-0 place-items-center rounded-xl">
                  <Icon name={item.icon} class="size-4.5" />
                </span>
                <span id={`wf-label-${item.id}`} class="wf-label text-lg font-medium tracking-tight">{item.label}</span>
              </span>
              <span class="wf-more grid">
                <span class="overflow-hidden">
                  <span id={`wf-body-${item.id}`} class="block pb-5 text-[0.9375rem] leading-relaxed text-muted">{item.body}</span>
                </span>
              </span>
              <span class="wf-bar block h-px bg-line" aria-hidden="true">
                <span class="wf-progress block h-0.5 -translate-y-px bg-brand" data-progress></span>
              </span>
            </button>
          ))
        }
      </div>

      <div class="wf-canvas dither relative overflow-hidden rounded-3xl bg-page px-4 pt-16 pb-6 sm:p-8 lg:p-10">
        <button
          type="button"
          class="absolute top-3 right-3 z-10 grid size-9 place-items-center rounded-full bg-surface text-muted shadow-(--shadow-float) transition-colors hover:text-ink"
          aria-label="Pause playbook animation"
          data-pause
        >
          <span class="grid" data-icon-pause><Icon name="circle-pause" class="size-4.5" /></span>
          <span class="hidden" data-icon-play><Icon name="play" class="size-4" /></span>
        </button>

        {
          workflows.items.map((item, index) => (
            <div
              role="tabpanel"
              id={`wf-panel-${item.id}`}
              aria-labelledby={`wf-tab-${item.id}`}
              tabindex="0"
              class="flow relative"
              hidden={index !== 0}
              data-panel
              data-step="6"
            >
              <h3 class="sr-only">{item.label}: how the playbook runs</h3>
              {item.nodes.map((node, n) => (
                <>
                  <article class:list={["node", n === 3 && "node-end"]} style={`grid-area:${areas[n * 2]}`} data-seq={n * 2}>
                    <header class="flex items-center gap-3">
                      <span class="node-icon grid size-9 shrink-0 place-items-center rounded-[0.7rem]">
                        <Icon name={node.icon} class="size-4.5" />
                      </span>
                      <span class="min-w-0">
                        <span class="block truncate text-[0.9375rem] leading-tight font-semibold">{node.title}</span>
                        <span class="mt-0.5 block truncate text-xs text-muted">{node.sub}</span>
                      </span>
                    </header>
                    {node.rows && (
                      <dl class="mt-3 grid text-[0.8125rem]">
                        {node.rows.map(([key, value]) => (
                          <div class="flex justify-between gap-3 border-t border-line/70 py-1.5">
                            <dt class="text-muted">{key}</dt>
                            <dd class="text-right font-medium tabular">{value}</dd>
                          </div>
                        ))}
                      </dl>
                    )}
                    {node.note && <p class="mt-2 rounded-lg bg-brand-wash px-2.5 py-1.5 text-xs font-medium">{node.note}</p>}
                    {node.tools && (
                      <ul class="mt-3 grid gap-1.5 text-[0.8125rem]">
                        {node.tools.map((tool) => (
                          <li class="flex items-center gap-2">
                            <Icon name="circle-check" class="size-4 text-good" />
                            {tool}
                          </li>
                        ))}
                      </ul>
                    )}
                    {node.bubble && (
                      <p class="mt-3 rounded-2xl rounded-bl-md bg-brand px-3.5 py-2.5 text-[0.8125rem] leading-snug text-white">{node.bubble}</p>
                    )}
                  </article>
                  {n < 3 && (
                    <div class:list={["joint", n === 1 ? "joint-x" : "joint-y"]} style={`grid-area:${areas[n * 2 + 1]}`} data-seq={n * 2 + 1}>
                      <span class="joint-chip">
                        <span class="joint-state" aria-hidden="true">
                          <span class="spinner" />
                          <Icon name="check" class="tick size-3.5" stroke={2.5} />
                        </span>
                        {item.steps[n]}
                      </span>
                    </div>
                  )}
                </>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-10 text-center">
      <a href={primary.href} class="btn btn-primary">
        {workflows.cta}
        <Icon name="arrow-right" class="btn-arrow" stroke={2} />
      </a>
    </div>
  </div>
</section>

<style>
  .wf-tab + .wf-tab {
    margin-top: 0.25rem;
  }

  .wf-icon {
    background: var(--page);
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .wf-label {
    color: var(--muted);
    transition: color 0.3s;
  }

  .wf-tab:hover .wf-label,
  .wf-tab[aria-selected="true"] .wf-label {
    color: var(--ink);
  }

  .wf-tab[aria-selected="true"] .wf-icon {
    background: var(--brand);
    color: var(--on-brand);
    box-shadow: 0 8px 18px -8px rgb(75 59 255 / 0.8);
  }

  .wf-more {
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--ease-out-expo);
  }

  .wf-tab[aria-selected="true"] .wf-more {
    grid-template-rows: 1fr;
  }

  .wf-progress {
    width: 100%;
    transform-origin: left;
    transform: scaleX(0);
  }

  .wf-tab:not([aria-selected="true"]) .wf-progress {
    transform: scaleX(0) !important;
  }

  .wf-canvas {
    min-height: 34rem;
    display: grid;
    align-items: center;
  }

  .flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "n0" "c0" "n1" "c1" "n2" "c2" "n3";
    max-width: 50rem;
    margin-inline: auto;
    width: 100%;
  }

  @media (min-width: 48rem) {
    .flow {
      grid-template-columns: minmax(0, 1fr) 8.5rem minmax(0, 1fr);
      grid-template-areas:
        "n0 . n3"
        "c0 . c2"
        "n1 c1 n2";
      align-items: start;
    }
  }

  .flow:focus-visible {
    outline-offset: 8px;
  }

  .node {
    position: relative;
    z-index: 1;
    padding: 1rem;
    border-radius: 1.1rem;
    background: var(--surface);
    box-shadow:
      0 0 0 1px var(--line),
      0 1px 2px rgb(12 12 29 / 0.04);
    transition:
      opacity 0.5s,
      transform 0.6s var(--ease-out-expo),
      box-shadow 0.4s;
  }

  .node-icon {
    background: var(--page);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .node-end .node-icon {
    background: var(--good-soft);
    color: var(--good);
    box-shadow: none;
  }

  .joint {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 4.5rem;
  }

  .joint::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    border-left: 1.5px dashed color-mix(in srgb, var(--ink) 18%, transparent);
  }

  @media (min-width: 48rem) {
    .joint-x {
      align-self: center;
      min-height: 0;
    }

    .joint-x::before {
      left: -0.25rem;
      right: -0.25rem;
      top: 50%;
      bottom: auto;
      border-left: 0;
      border-top: 1.5px dashed color-mix(in srgb, var(--ink) 18%, transparent);
    }
  }

  .joint-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem 0.35rem 0.45rem;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line);
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    transition:
      opacity 0.4s,
      background-color 0.3s,
      color 0.3s;
  }

  .joint-state {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: var(--sunken);
  }

  .joint-state > * {
    grid-area: 1 / 1;
  }

  .spinner {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    border: 1.5px solid color-mix(in srgb, var(--brand) 25%, transparent);
    border-top-color: var(--brand);
    animation: spin 0.8s linear infinite;
    opacity: 0;
  }

  .tick {
    color: var(--good);
    opacity: 0;
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  /* Sequence states, driven by `data-step` on the panel. */
  .flow [data-seq].is-pending {
    opacity: 0.35;
  }

  .flow .node.is-pending {
    transform: translateY(0.4rem) scale(0.985);
    box-shadow: 0 0 0 1px var(--line);
  }

  .flow .node.is-active {
    box-shadow:
      0 0 0 1.5px var(--brand),
      0 0 0 6px var(--brand-soft),
      var(--shadow-lift);
  }

  .flow .node-end.is-done {
    box-shadow:
      0 0 0 1.5px color-mix(in srgb, var(--good) 55%, transparent),
      0 0 0 6px var(--good-soft);
  }

  .flow .joint.is-active .joint-chip {
    background: var(--brand-soft);
    color: var(--brand-ink);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--brand) 30%, transparent);
  }

  .flow .joint.is-active .spinner {
    opacity: 1;
  }

  .flow .joint.is-done .tick {
    opacity: 1;
  }

  .flow .joint.is-done::before {
    border-color: color-mix(in srgb, var(--brand) 55%, transparent);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-workflows]");

  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    const pause = root.querySelector<HTMLButtonElement>("[data-pause]");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const STEP_MS = 900;
    const HOLD_MS = 2800;
    const LAST = 6;
    const TOTAL = STEP_MS * (LAST + 1) + HOLD_MS;

    let current = 0;
    let elapsed = 0;
    let hovering = false;
    let focused = false;
    let visible = false;
    let userPaused = reduce;

    const paint = (panel: HTMLElement, step: number) => {
      panel.dataset.step = String(step);
      panel.querySelectorAll<HTMLElement>("[data-seq]").forEach((el) => {
        const seq = Number(el.dataset.seq);
        el.classList.toggle("is-pending", seq > step);
        el.classList.toggle("is-active", seq === step && step < LAST + 1);
        el.classList.toggle("is-done", seq < step || (seq === LAST && step >= LAST));
      });
    };

    const render = () => {
      const step = reduce ? LAST : Math.min(LAST, Math.floor(elapsed / STEP_MS));
      paint(panels[current], step);
      const bar = tabs[current].querySelector<HTMLElement>("[data-progress]");
      if (bar) bar.style.transform = `scaleX(${reduce ? 0 : Math.min(1, elapsed / TOTAL)})`;
    };

    const select = (index: number, focus = false) => {
      current = (index + tabs.length) % tabs.length;
      elapsed = 0;
      tabs.forEach((tab, i) => {
        const on = i === current;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[current].focus();
      render();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index));
      tab.addEventListener("keydown", (event) => {
        const keys: Record<string, number> = {
          ArrowDown: index + 1,
          ArrowRight: index + 1,
          ArrowUp: index - 1,
          ArrowLeft: index - 1,
          Home: 0,
          End: tabs.length - 1,
        };
        if (!(event.key in keys)) return;
        event.preventDefault();
        select(keys[event.key], true);
      });
    });

    const setPaused = (paused: boolean) => {
      userPaused = paused;
      pause?.setAttribute("aria-label", paused ? "Play playbook animation" : "Pause playbook animation");
      pause?.querySelector("[data-icon-pause]")?.classList.toggle("hidden", paused);
      pause?.querySelector("[data-icon-play]")?.classList.toggle("hidden", !paused);
    };

    if (reduce) {
      pause?.remove();
      panels.forEach((panel) => paint(panel, LAST));
    } else {
      pause?.addEventListener("click", () => setPaused(!userPaused));
      root.addEventListener("pointerenter", () => (hovering = true));
      root.addEventListener("pointerleave", () => (hovering = false));
      root.addEventListener("focusin", () => (focused = true));
      root.addEventListener("focusout", (event) => {
        if (!root.contains(event.relatedTarget as Node | null)) focused = false;
      });
      new IntersectionObserver(([entry]) => (visible = entry.isIntersecting), { threshold: 0.3 }).observe(root);

      let last = performance.now();
      const tick = (now: number) => {
        const delta = Math.min(100, now - last);
        last = now;
        if (visible && !userPaused && !hovering && !focused && !document.hidden) {
          elapsed += delta;
          if (elapsed >= TOTAL) select(current + 1);
          else render();
        } else if (!userPaused && visible && (hovering || focused) && elapsed < STEP_MS * (LAST + 1)) {
          /* Hovering still lets the current playbook finish, it just won't move on. */
          elapsed = Math.min(elapsed + delta, STEP_MS * (LAST + 1));
          render();
        }
        requestAnimationFrame(tick);
      };
      render();
      requestAnimationFrame(tick);
    }
  }
</script>
