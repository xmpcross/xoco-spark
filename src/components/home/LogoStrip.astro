---
import CompanyLogo from "@/components/ui/CompanyLogo.astro";
import { logoStrip } from "@/config/home";
---

<section class="py-14 sm:py-20" aria-labelledby="logos-title">
  <div class="shell">
    <h2 id="logos-title" class="text-center text-sm font-medium text-muted">{logoStrip.title}</h2>
    <div class="marquee mt-8 overflow-hidden">
      <ul class="track flex w-max items-center">
        {
          [...logoStrip.items, ...logoStrip.items].map((name, index) => (
            <li class="px-7 text-ink/70 sm:px-10" aria-hidden={index >= logoStrip.items.length ? "true" : undefined}>
              <CompanyLogo name={name} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .marquee {
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }

  .track {
    animation: scroll 50s linear infinite;
  }

  .marquee:hover .track {
    animation-play-state: paused;
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
      row-gap: 1.5rem;
    }

    .track li[aria-hidden] {
      display: none;
    }
  }
</style>
