---
import AppWindow from "@/components/app/AppWindow.astro";
import InboxView from "@/components/app/InboxView.astro";
import Accent from "@/components/ui/Accent.astro";
import Icon from "@/components/ui/Icon.astro";
import { hero } from "@/config/home";
import { siteConfig } from "@/config/site";

const { primary, secondary } = siteConfig.actions;
const { announcement } = siteConfig;
---

<section class="hero pattern relative -mt-(--header-h) pt-[calc(var(--header-h)+2.5rem)] pb-16 sm:pt-[calc(var(--header-h)+4rem)] lg:pb-24" aria-labelledby="hero-title">
  <div class="shell text-center">
    {
      announcement.enabled && (
        <a
          href={announcement.href}
          class="rise group inline-flex max-w-full items-center gap-2.5 rounded-full bg-surface/80 py-1 pr-3 pl-1 text-sm shadow-[inset_0_0_0_1px_var(--line)] backdrop-blur transition-shadow hover:shadow-[inset_0_0_0_1px_var(--brand)]"
        >
          <span class="rounded-full bg-ink px-2.5 py-1 text-xs font-semibold text-spark">{announcement.badge}</span>
          <span class="truncate font-medium">{announcement.text}</span>
          <Icon name="arrow-right" class="btn-arrow size-3.5 text-muted" stroke={2} />
        </a>
      )
    }

    <h1 id="hero-title" class="rise mx-auto mt-7 max-w-5xl text-display-xl" style="--i:1">
      <Accent text={hero.title} />
    </h1>
    <p class="rise mx-auto mt-6 max-w-2xl text-lead text-muted" style="--i:2">{hero.lead}</p>

    <div class="rise mt-9 flex flex-wrap justify-center gap-3" style="--i:3">
      <a href={primary.href} class="btn btn-brand">
        {primary.label}
        <Icon name="arrow-right" class="btn-arrow" stroke={2} />
      </a>
      <a href={secondary.href} class="btn btn-ghost">{secondary.label}</a>
    </div>

    <ul class="rise mt-6 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm text-muted" style="--i:4">
      {
        hero.notes.map((note) => (
          <li class="inline-flex items-center gap-1.5">
            <Icon name="circle-check" class="size-4 text-good" />
            {note}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="shell relative mt-14 sm:mt-16">
    <div class="stage rise relative mx-auto max-w-6xl" style="--i:5">
      <div class="canvas relative isolate overflow-hidden rounded-card p-2 sm:p-8 lg:p-12">
        <AppWindow label={hero.productLabel} tone="light">
          <InboxView class="h-140 sm:h-152 lg:h-164" />
        </AppWindow>
      </div>

    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(to bottom, var(--surface) 70%, var(--page));
  }

  .canvas {
    background: var(--sunken);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .canvas::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    opacity: 0.06;
    mask: url("/textures/dither.png") repeat-x center top / 2400px 720px;
  }
</style>
