---
import { Image } from "astro:assets";
import InboxView from "@/components/app/InboxView.astro";
import Icon from "@/components/ui/Icon.astro";
import Wordmark from "@/components/ui/Wordmark.astro";
import { testimonials } from "@/config/home";
import { navigation, siteConfig, type MenuFeature } from "@/config/site";
import { formatDate, getPosts, postHref } from "@/lib/posts";

const latest = (await getPosts())[0];
const story = testimonials.items[0];
const { primary, signIn } = siteConfig.actions;
const path = Astro.url.pathname;

const isCurrent = (href: string) => !href.includes("#") && href !== "/" && path.startsWith(href);
const menus = navigation.map((item, index) => ({ ...item, id: `menu-${index}` }));
const featureOf = (item: (typeof menus)[number]): MenuFeature | undefined =>
  "columns" in item ? item.feature : undefined;
---

<header class="site-header fixed inset-x-0 top-0 z-50" data-header>
  <div class="shell relative">
    <div class="header-bar relative z-20 flex h-(--header-h) items-center gap-4 lg:grid lg:grid-cols-[1fr_auto_1fr]">
      <a href="/" class="flex shrink-0 lg:justify-self-start" aria-label={`${siteConfig.name} home`} data-logo-menu-trigger>
        <Wordmark class="h-6.5" />
      </a>

      <nav class="hidden lg:block" aria-label="Main">
        <ul class="flex items-center gap-0.5">
          {
            menus.map((item) => (
              <li>
                {"columns" in item ? (
                  <button
                    type="button"
                    class="nav-trigger"
                    aria-expanded="false"
                    aria-controls={item.id}
                    data-menu-trigger={item.id}
                  >
                    {item.label}
                    <Icon name="chevron-down" class="nav-chevron size-3.5" stroke={2} />
                  </button>
                ) : (
                  <a href={item.href} class="nav-trigger" aria-current={isCurrent(item.href) ? "page" : undefined}>
                    {item.label}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="ml-auto flex items-center gap-1 sm:gap-2 lg:justify-self-end">
        <a href={signIn.href} class="hidden rounded-full px-3.5 py-2 text-[0.9375rem] font-medium whitespace-nowrap transition-colors hover:bg-ink/5 md:inline-block">
          {signIn.label}
        </a>
        <a href={primary.href} class="btn btn-primary btn-sm hidden sm:inline-flex">
          {primary.label}
          <Icon name="arrow-right" class="btn-arrow" stroke={2} />
        </a>
        <button
          type="button"
          class="-mr-2 grid size-11 place-items-center rounded-full transition-colors hover:bg-ink/5 lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Open menu"
          data-mobile-toggle
        >
          <span class="grid" data-icon-open><Icon name="menu" class="size-5" /></span>
          <span class="hidden" data-icon-close><Icon name="x" class="size-5" /></span>
        </button>
      </div>
    </div>

    {
      menus.map(
        (item) =>
          "columns" in item && (
            <div id={item.id} class="dropdown absolute top-[calc(100%+0.5rem)] left-1/2 z-10 hidden w-[min(54rem,calc(100vw-2*var(--gutter)))] lg:block" data-menu-panel>
              <div class="dropdown-card grid grid-cols-[1fr_1fr_17rem] gap-2 rounded-3xl bg-surface p-2">
                {item.columns.map((column, index) => (
                  <div class="dropdown-col p-3" style={`--i:${index}`}>
                    {column.title && <p class="mb-2 px-2 text-xs font-semibold tracking-wide text-muted uppercase">{column.title}</p>}
                    <ul class="grid gap-0.5">
                      {column.links.map((link) => (
                        <li>
                          <a href={link.href} class="dropdown-link group" data-menu-link>
                            {link.icon && (
                              <span class="dropdown-icon">
                                <Icon name={link.icon} class="size-4.5" />
                              </span>
                            )}
                            <span class="min-w-0">
                              <span class="block text-[0.9375rem] font-medium">{link.label}</span>
                              {link.description && <span class="mt-0.5 block text-[0.8125rem] leading-snug text-muted">{link.description}</span>}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}

                <div class="dropdown-col" style="--i:2">
                  {featureOf(item) === "product" && (
                    <a href="/#platform" class="group flex h-full flex-col overflow-hidden rounded-[1.1rem] bg-brand-wash" data-menu-link>
                      <span class="block px-5 pt-5">
                        <span class="block text-[0.9375rem] leading-snug font-medium">See an agent resolve a ticket, start to finish</span>
                        <span class="mt-2 inline-flex items-center gap-1.5 text-sm font-medium text-brand">
                          Tour the platform <Icon name="arrow-right" class="btn-arrow size-3.5" stroke={2} />
                        </span>
                      </span>
                      <span class="mt-auto block pt-5 pl-5">
                        <span class="block h-60 overflow-hidden rounded-tl-xl bg-surface shadow-[0_0_0_1px_rgb(12_12_29/0.08)] transition-transform duration-700 group-hover:-translate-y-1" aria-hidden="true">
                          <InboxView class="menu-inbox h-120" />
                        </span>
                      </span>
                    </a>
                  )}
                  {featureOf(item) === "story" && (
                    <a href="/#customers" class="on-night pattern group flex h-full flex-col rounded-[1.1rem] p-5 [--glow:90%_90%_at_100%_0%]" data-menu-link>
                      <span class="text-xs font-semibold tracking-wide text-night-muted uppercase">Customer story</span>
                      <span class="mt-auto pt-8 text-5xl leading-none font-medium tracking-tight text-spark">{story.result.value}</span>
                      <span class="mt-2 text-sm text-night-muted">{story.result.label} at {story.company}</span>
                      <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium">
                        Read the stories <Icon name="arrow-right" class="btn-arrow size-3.5" stroke={2} />
                      </span>
                    </a>
                  )}
                  {featureOf(item) === "latest" && latest && (
                    <a href={postHref(latest)} class="group flex h-full flex-col overflow-hidden rounded-[1.1rem] bg-sunken" data-menu-link>
                      <span class="block aspect-[16/10] overflow-hidden">
                        <Image
                          src={latest.data.cover}
                          alt=""
                          width={480}
                          height={300}
                          class="size-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                      </span>
                      <span class="block p-4">
                        <span class="meta block">Latest · {formatDate(latest.data.date)}</span>
                        <span class="mt-1.5 line-clamp-2 block text-[0.9375rem] leading-snug font-medium group-hover:text-brand">
                          {latest.data.title}
                        </span>
                      </span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          ),
      )
    }
  </div>

  <div id="mobile-nav" class="mobile-nav fixed inset-x-0 top-0 bottom-0 z-10 overflow-y-auto bg-page lg:hidden" data-mobile-nav>
    <nav class="shell flex min-h-full flex-col pt-[calc(var(--header-h)+1rem)] pb-8" aria-label="Mobile">
      <ul class="divide-y divide-line">
        {
          menus.map((item) => (
            <li>
              {"columns" in item ? (
                <details class="mobile-group" name="mobile-menu">
                  <summary class="flex items-center justify-between py-4 text-2xl font-medium tracking-tight">
                    {item.label}
                    <span class="grid size-8 place-items-center rounded-full bg-sunken">
                      <Icon name="plus" class="mobile-plus size-4" stroke={2} />
                    </span>
                  </summary>
                  <ul class="grid gap-1 pb-5">
                    {item.columns
                      .flatMap((column) => column.links)
                      .map((link) => (
                        <li>
                          <a href={link.href} class="flex items-center gap-3 rounded-xl py-2 text-lg text-muted hover:text-ink" data-menu-link>
                            {link.icon && <Icon name={link.icon} class="size-4.5 text-brand" />}
                            {link.label}
                          </a>
                        </li>
                      ))}
                  </ul>
                </details>
              ) : (
                <a href={item.href} class="block py-4 text-2xl font-medium tracking-tight" data-menu-link>
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <div class="mt-auto grid gap-3 pt-10">
        <a href={primary.href} class="btn btn-primary w-full">
          {primary.label}
          <Icon name="arrow-right" class="btn-arrow" stroke={2} />
        </a>
        <a href={signIn.href} class="btn btn-ghost w-full">{signIn.label}</a>
      </div>
    </nav>
  </div>

  <div class="menu-scrim fixed inset-0 -z-10 bg-ink/10 backdrop-blur-[2px]" data-menu-scrim></div>
</header>

<style>
  :global(.menu-inbox) {
    zoom: 0.5;
  }

  .site-header {
    transition: transform 0.5s var(--ease-out-expo);
  }

  .site-header[data-hidden] {
    transform: translateY(-110%);
  }

  .header-bar::before {
    content: "";
    position: absolute;
    inset: 0.6rem calc(var(--gutter) * -0.5 - 0.5rem);
    z-index: -1;
    border-radius: 999px;
    background: rgb(255 255 255 / 0);
    box-shadow: 0 0 0 1px rgb(12 12 29 / 0);
    transition:
      background-color 0.4s,
      box-shadow 0.4s,
      inset 0.5s var(--ease-out-expo);
  }

  [data-scrolled] .header-bar::before,
  [data-menu-open] .header-bar::before {
    inset: 0.6rem -0.75rem;
    background: rgb(255 255 255 / 0.78);
    backdrop-filter: blur(16px) saturate(1.6);
    box-shadow:
      0 0 0 1px rgb(12 12 29 / 0.06),
      0 10px 30px -12px rgb(12 12 29 / 0.18);
  }

  [data-mobile-open] .header-bar::before {
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }

  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--ink) 82%, transparent);
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .nav-trigger:hover,
  .nav-trigger[aria-expanded="true"],
  .nav-trigger[aria-current="page"] {
    color: var(--ink);
    background: rgb(12 12 29 / 0.05);
  }

  .nav-chevron {
    opacity: 0.6;
    transition: transform 0.35s var(--ease-out-expo);
  }

  .nav-trigger[aria-expanded="true"] .nav-chevron {
    transform: rotate(180deg);
  }

  .dropdown {
    visibility: hidden;
    opacity: 0;
    transform: translate(-50%, -0.5rem) scale(0.98);
    transform-origin: top center;
    transition:
      opacity 0.2s,
      transform 0.35s var(--ease-out-expo),
      visibility 0s 0.35s;
  }

  .dropdown[data-open] {
    visibility: visible;
    opacity: 1;
    transform: translate(-50%, 0);
    transition:
      opacity 0.25s,
      transform 0.45s var(--ease-out-expo);
  }

  .dropdown-card {
    box-shadow:
      0 0 0 1px rgb(12 12 29 / 0.06),
      0 30px 60px -20px rgb(12 12 29 / 0.28);
  }

  .dropdown-col {
    opacity: 0;
    transform: translateY(-0.35rem);
    transition:
      opacity 0.3s,
      transform 0.5s var(--ease-out-expo);
  }

  .dropdown[data-open] .dropdown-col {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 40ms + 40ms);
  }

  .dropdown-link {
    display: flex;
    gap: 0.75rem;
    padding: 0.6rem 0.6rem;
    border-radius: 0.875rem;
    transition: background-color 0.2s;
  }

  .dropdown-link:hover,
  .dropdown-link:focus-visible {
    background: var(--page);
  }

  .dropdown-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.7rem;
    background: var(--page);
    color: var(--brand);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .dropdown-link:hover .dropdown-icon {
    background: var(--brand);
    color: var(--on-brand);
    box-shadow: none;
  }

  .menu-scrim {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s,
      visibility 0s 0.3s;
  }

  [data-menu-open] .menu-scrim {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s;
  }

  .mobile-nav {
    overscroll-behavior: contain;
    scrollbar-width: none;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 0.3s,
      visibility 0s 0.3s;
  }

  [data-mobile-open] .mobile-nav {
    visibility: visible;
    opacity: 1;
    transition: opacity 0.3s;
  }

  .mobile-nav::-webkit-scrollbar {
    display: none;
  }

  .mobile-group summary {
    list-style: none;
    cursor: pointer;
  }

  .mobile-group summary::-webkit-details-marker {
    display: none;
  }

  .mobile-plus {
    transition: transform 0.35s var(--ease-out-expo);
  }

  .mobile-group[open] .mobile-plus {
    transform: rotate(45deg);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");

  if (header) {
    const triggers = [...header.querySelectorAll<HTMLButtonElement>("[data-menu-trigger]")];
    const panels = [...header.querySelectorAll<HTMLElement>("[data-menu-panel]")];
    const scrim = header.querySelector<HTMLElement>("[data-menu-scrim]");
    const mobileToggle = header.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    let current: string | null = null;
    let hoverTimer = 0;

    const setMenu = (id: string | null, focusFirst = false) => {
      current = id;
      triggers.forEach((trigger) => trigger.setAttribute("aria-expanded", String(trigger.dataset.menuTrigger === id)));
      panels.forEach((panel) => panel.toggleAttribute("data-open", panel.id === id));
      header.toggleAttribute("data-menu-open", id !== null);
      if (id && focusFirst) {
        document.getElementById(id)?.querySelector<HTMLElement>("a")?.focus();
      }
    };

    const closeMenu = (returnFocus = false) => {
      const trigger = triggers.find((item) => item.dataset.menuTrigger === current);
      setMenu(null);
      if (returnFocus) trigger?.focus();
    };

    triggers.forEach((trigger) => {
      const id = trigger.dataset.menuTrigger ?? null;
      trigger.addEventListener("click", () => setMenu(current === id ? null : id));
      trigger.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          setMenu(id, true);
        }
      });
      trigger.addEventListener("pointerenter", () => {
        if (!finePointer.matches) return;
        window.clearTimeout(hoverTimer);
        hoverTimer = window.setTimeout(() => setMenu(id), current ? 0 : 90);
      });
    });

    /* The gap between the bar and a dropdown is not part of either, so leaving
       one starts a short timer and the menu closes only if the pointer is in
       neither box when it runs. */
    const bar = header.querySelector<HTMLElement>(".header-bar");
    const hoverZones = [bar, ...panels].filter((el): el is HTMLElement => el !== null);
    let pointer = { x: 0, y: 0 };
    document.addEventListener("pointermove", (event) => (pointer = { x: event.clientX, y: event.clientY }), {
      passive: true,
    });
    const scheduleClose = () => {
      if (!finePointer.matches || !current) return;
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => {
        const inside = hoverZones.some((zone) => {
          if (zone !== bar && zone.id !== current) return false;
          const box = zone.getBoundingClientRect();
          return pointer.x >= box.left && pointer.x <= box.right && pointer.y >= box.top - 12 && pointer.y <= box.bottom;
        });
        if (!inside) closeMenu();
      }, 260);
    };
    hoverZones.forEach((zone) => {
      zone.addEventListener("pointerleave", scheduleClose);
      zone.addEventListener("pointerenter", () => {
        if (current) window.clearTimeout(hoverTimer);
      });
    });

    bar?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      link.addEventListener("pointerenter", () => {
        if (!finePointer.matches || !current) return;
        window.clearTimeout(hoverTimer);
        hoverTimer = window.setTimeout(() => closeMenu(), 90);
      });
      link.addEventListener("focus", () => {
        if (current) closeMenu();
      });
    });

    scrim?.addEventListener("click", () => closeMenu());

    header.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (current && next && !header.contains(next)) closeMenu();
    });

    const setMobile = (open: boolean) => {
      header.toggleAttribute("data-mobile-open", open);
      mobileToggle?.setAttribute("aria-expanded", String(open));
      mobileToggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      mobileToggle?.querySelector("[data-icon-open]")?.classList.toggle("hidden", open);
      mobileToggle?.querySelector("[data-icon-close]")?.classList.toggle("hidden", !open);
      document.documentElement.style.overflow = open ? "hidden" : "";
    };

    mobileToggle?.addEventListener("click", () => setMobile(!header.hasAttribute("data-mobile-open")));

    header.querySelectorAll("[data-menu-link]").forEach((link) =>
      link.addEventListener("click", () => {
        closeMenu();
        setMobile(false);
      }),
    );

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (current) closeMenu(true);
      if (header.hasAttribute("data-mobile-open")) {
        setMobile(false);
        mobileToggle?.focus();
      }
    });

    window.matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
      if (event.matches) setMobile(false);
      else closeMenu();
    });

    /* Hide while scrolling down, return on any scroll up. Never hides near the
       top, or while a menu or the mobile sheet is open. */
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      const busy = current !== null || header.hasAttribute("data-mobile-open") || header.contains(document.activeElement);
      header.toggleAttribute("data-scrolled", y > 8);
      if (y < 160 || busy) header.removeAttribute("data-hidden");
      else if (Math.abs(y - lastY) > 6) header.toggleAttribute("data-hidden", y > lastY);
      lastY = y;
      document.documentElement.toggleAttribute("data-header-hidden", header.hasAttribute("data-hidden"));
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    header.addEventListener("focusin", () => header.removeAttribute("data-hidden"));
  }
</script>
