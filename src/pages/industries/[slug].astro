---
import { Image } from "astro:assets";
import Faq from "@/components/home/Faq.astro";
import Accent from "@/components/ui/Accent.astro";
import CompanyLogo from "@/components/ui/CompanyLogo.astro";
import Icon from "@/components/ui/Icon.astro";
import { testimonials } from "@/config/home";
import { type IndustryPage, industryPages } from "@/config/industries";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
  return industryPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props {
  page: IndustryPage;
}

const { page } = Astro.props;
const { primary } = siteConfig.actions;
const story = testimonials.items.find((item) => item.name === page.story);

const peakMax = Math.max(...page.peak.days.map((day) => day.contacts));
const yOf = (value: number) => 300 - (value / peakMax) * 270;
const xOf = (i: number) => (i / (page.peak.days.length - 1)) * 1000;
/* Catmull-Rom through every point, so the crosshair dots sit on the line. */
const smooth = (values: number[]) =>
  values
    .map((v, i) => [xOf(i), yOf(v)])
    .reduce((d, [x, y], i, pts) => {
      if (i === 0) return `M${x},${y}`;
      const [x0, y0] = pts[i - 1];
      const [xp, yp] = pts[i - 2] ?? pts[i - 1];
      const [xn, yn] = pts[i + 1] ?? [x, y];
      return `${d}C${x0 + (x - xp) / 6},${y0 + (y - yp) / 6},${x - (xn - x0) / 6},${y - (yn - y0) / 6},${x},${y}`;
    }, "");
const totalLine = smooth(page.peak.days.map((day) => day.contacts));
const handoffLine = smooth(page.peak.days.map((day) => day.handedOff));
const peakDay = page.peak.days.reduce((a, b) => (b.contacts > a.contacts ? b : a));
const resolvedShare = (day: { contacts: number; handedOff: number }) =>
  Math.round(((day.contacts - day.handedOff) / day.contacts) * 100);
const format = (value: number) => value.toLocaleString(siteConfig.dateLocale);
const caption = (day: IndustryPage["peak"]["days"][number]) =>
  `contacts on ${day.highlight ?? day.date}, ${resolvedShare(day)}% resolved by the agent`;
const plot = page.peak.days.map((day, i) => ({
  date: day.date,
  highlight: day.highlight,
  x: xOf(i) / 10,
  total: yOf(day.contacts) / 3,
  handoff: yOf(day.handedOff) / 3,
  value: format(day.contacts),
  caption: caption(day),
}));
const intentMax = Math.max(...page.intents.items.map((item) => item.share));
---

<BaseLayout title={page.name} description={page.lead} image={page.photo} imageAlt={page.photoAlt}>
  <section class="pattern -mt-(--header-h) pt-[calc(var(--header-h)+3rem)] pb-4 sm:pt-[calc(var(--header-h)+5rem)]">
    <div class="shell text-center">
      <nav class="rise meta inline-flex gap-2 rounded-full bg-surface px-4 py-1.5 shadow-[inset_0_0_0_1px_var(--line)]" aria-label="Breadcrumb">
        <a href="/#workflows" class="hover:text-ink">Solutions</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="text-ink">{page.name}</span>
      </nav>
      <h1 class="rise mx-auto mt-6 max-w-5xl text-display-xl" style="--i:1"><Accent text={page.title} /></h1>
      <p class="rise mx-auto mt-6 max-w-2xl text-lead text-muted" style="--i:2">{page.lead}</p>
      <div class="rise mt-9 flex flex-wrap justify-center gap-3" style="--i:3">
        <a href={primary.href} class="btn btn-brand">
          {primary.label}
          <Icon name="arrow-right" class="btn-arrow" stroke={2} />
        </a>
        <a href="#playbook" class="btn btn-ghost">See the playbook</a>
      </div>
    </div>
  </section>

  <div class="shell mt-12">
    <div class="rise relative overflow-hidden rounded-card" style="--i:4">
      <div class="relative aspect-4/3 sm:aspect-video lg:aspect-21/9">
        <Image
          src={page.photo}
          alt={page.photoAlt}
          widths={[640, 960, 1400, 2000]}
          sizes="(min-width: 1344px) 84rem, 100vw"
          loading="eager"
          class="absolute inset-0 size-full object-cover"
        />
      </div>
      <dl class="grid grid-cols-2 gap-2 bg-page pt-2 lg:absolute lg:inset-x-6 lg:bottom-6 lg:grid-cols-4 lg:bg-transparent lg:pt-0">
        {
          page.metrics.map((metric) => (
            <div class="flex flex-col rounded-2xl bg-surface p-5 shadow-[inset_0_0_0_1px_var(--line)] lg:bg-surface/90 lg:shadow-(--shadow-float) lg:backdrop-blur">
              <dt class="order-2 mt-3 text-sm text-muted">{metric.label}</dt>
              <dd class="order-1 text-4xl leading-none font-medium tracking-tight text-brand sm:text-5xl">{metric.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <section class="py-20 lg:py-32" aria-labelledby="intents-title">
    <div class="shell">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <h2 id="intents-title" class="reveal text-display-md lg:col-span-6"><Accent text={page.intents.title} /></h2>
        <p class="reveal text-lead text-muted lg:col-span-5 lg:col-start-8">{page.intents.lead}</p>
      </div>

      <div class="reveal mt-12 lg:mt-16">
        <div class="meta hidden grid-cols-[minmax(0,1.6fr)_minmax(0,1.4fr)_6rem_minmax(0,1fr)] gap-6 px-6 pb-3 lg:grid" aria-hidden="true">
          <span>Intent</span>
          <span>Share of contacts</span>
          <span class="text-right">Resolved</span>
          <span>Playbook</span>
        </div>
        <ul class="grid gap-2">
          {
            page.intents.items.map((item) => (
              <li class="grid items-center gap-x-6 gap-y-3 rounded-2xl bg-surface p-5 shadow-[inset_0_0_0_1px_var(--line)] lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1.4fr)_6rem_minmax(0,1fr)] lg:px-6">
                <span>
                  <span class="block text-[1.05rem] font-medium">{item.intent}</span>
                  <span class="mt-0.5 block text-sm text-muted">“{item.example}”</span>
                </span>
                <span class="flex items-center gap-3">
                  <span class="h-2 flex-1 overflow-hidden rounded-full bg-sunken">
                    <span class="block h-full rounded-full bg-brand" style={`width:${(item.share / intentMax) * 100}%`} />
                  </span>
                  <span class="w-10 text-right text-sm font-medium tabular">
                    {item.share}%<span class="sr-only"> of contacts</span>
                  </span>
                </span>
                <span class="text-sm font-medium tabular lg:text-right">
                  {item.resolved > 0 ? `${item.resolved}%` : "To a person"}
                  <span class="text-muted lg:hidden"> resolved</span>
                </span>
                <span><span class="rounded-full bg-brand-soft px-2.5 py-1 text-xs font-semibold text-brand-ink">{item.playbook}</span></span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="playbook" class="on-night pattern py-20 lg:py-32" aria-labelledby="playbook-title">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <h2 id="playbook-title" class="reveal text-display-md"><Accent text={page.playbook.title} /></h2>
        <p class="reveal mt-6 text-lead text-night-muted">{page.playbook.lead}</p>
        <ul class="reveal mt-10 grid gap-3">
          {
            page.playbook.points.map((point) => (
              <li class="flex gap-3">
                <Icon name="check" class="mt-1 size-4 text-spark" stroke={2.5} />
                <span>{point}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="reveal relative lg:col-span-6 lg:col-start-7 lg:self-center">
        <div class="relative aspect-square overflow-hidden rounded-card sm:aspect-4/3">
          <Image
            src={page.playbook.photo}
            alt={page.playbook.photoAlt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 42rem, 100vw"
            class="absolute inset-0 size-full object-cover object-[20%_center] sm:object-center"
          />
        </div>
        <p
          class="absolute top-[40%] right-4 max-w-52 rounded-2xl rounded-br-md bg-brand px-4 py-3 text-[0.9rem] leading-snug text-white shadow-[0_18px_40px_-18px_rgb(0_0_0/0.55)] sm:top-6 sm:right-6 sm:max-w-64 lg:-right-6"
        >
          <span class="sr-only">Customer: </span>
          {page.playbook.question}
        </p>
        <p
          class="absolute bottom-4 left-4 flex items-center gap-3 rounded-2xl bg-surface py-3 pr-5 pl-3 text-ink shadow-[0_18px_40px_-18px_rgb(0_0_0/0.45)] sm:bottom-6 sm:left-6 lg:-left-6"
        >
          <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-good-soft text-good">
            <Icon name="check" class="size-4" stroke={2} />
          </span>
          <span class="text-sm leading-tight">
            <span class="block font-medium">{page.playbook.result.title}</span>
            <span class="text-muted">{page.playbook.result.detail}</span>
          </span>
        </p>
      </figure>
    </div>
  </section>

  <section class="py-20 lg:py-32" aria-labelledby="peak-title">
    <div class="shell">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <h2 id="peak-title" class="reveal max-w-xl text-display-md lg:col-span-6"><Accent text={page.peak.title} /></h2>
        <p class="reveal text-lead text-muted lg:col-span-5 lg:col-start-8">{page.peak.lead}</p>
      </div>

      <figure class="reveal mt-12 rounded-card bg-surface p-5 shadow-[inset_0_0_0_1px_var(--line)] sm:p-8 lg:mt-16" data-peak>
        <div class="flex flex-wrap items-end justify-between gap-6">
          <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1" aria-live="polite">
            <span class="text-6xl leading-none font-medium tracking-tight text-brand tabular-nums" data-peak-value>{format(peakDay.contacts)}</span>
            <span class="text-sm text-muted" data-peak-caption>{caption(peakDay)}</span>
          </p>
          <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted" aria-label="Legend">
            <li class="flex items-center gap-2"><span class="h-1 w-4 rounded-full bg-brand" />All contacts</li>
            <li class="flex items-center gap-2"><span class="h-1 w-4 rounded-full bg-ink" />Handed to a person</li>
          </ul>
        </div>

        <div
          class="peak relative mt-12 h-60 cursor-crosshair touch-pan-y outline-none sm:h-80"
          tabindex="0"
          aria-label="Contacts per day. Use the arrow keys to read each day."
          data-peak-plot
          data-points={JSON.stringify(plot)}
        >
          <svg class="absolute inset-0 size-full overflow-visible" viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id={`${page.slug}-peak-fill`} x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="var(--brand)" stop-opacity="0.28" />
                <stop offset="1" stop-color="var(--brand)" stop-opacity="0.02" />
              </linearGradient>
            </defs>
            {[75, 150, 225, 300].map((y) => <line x1="0" x2="1000" y1={y} y2={y} class="stroke-line" vector-effect="non-scaling-stroke" />)}
            <g class="peak-draw">
              <path d={`${totalLine}L1000,300L0,300Z`} fill={`url(#${page.slug}-peak-fill)`} />
              <path d={`${handoffLine}L1000,300L0,300Z`} class="fill-ink/8" />
              <path d={totalLine} class="fill-none stroke-brand" stroke-width="2.5" vector-effect="non-scaling-stroke" />
              <path d={handoffLine} class="fill-none stroke-ink" stroke-width="1.5" vector-effect="non-scaling-stroke" />
            </g>
          </svg>

          {
            plot
              .filter((point) => point.highlight)
              .map((point) => (
                <span class="pointer-events-none absolute" style={`left:${point.x}%;top:${point.total}%`} aria-hidden="true">
                  <span class="meta absolute bottom-3 left-1/2 w-max -translate-x-1/2 rounded-full bg-ink px-2 py-0.5 text-xs! text-page!">{point.highlight}</span>
                  <span class="absolute size-2.5 -translate-1/2 rounded-full bg-brand ring-2 ring-surface" />
                </span>
              ))
          }

          <span class="pointer-events-none absolute inset-y-0 w-px bg-ink/40" data-peak-cross hidden>
            <span class="absolute left-1/2 size-3 -translate-1/2 rounded-full border-2 border-surface bg-brand" data-peak-dot="total" />
            <span class="absolute left-1/2 size-3 -translate-1/2 rounded-full border-2 border-surface bg-ink" data-peak-dot="handoff" />
          </span>
        </div>

        <div class="meta relative mt-3 h-4 text-[0.6875rem]! sm:text-xs!" aria-hidden="true">
          {
            plot.map((point, i) => (
              <span
                class:list={[
                  "peak-date absolute top-0 w-max",
                  i === 0 ? "left-0" : i === plot.length - 1 ? "right-0" : "-translate-x-1/2",
                  i % 2 === 1 && "max-sm:hidden",
                ]}
                style={i === 0 || i === plot.length - 1 ? undefined : `left:${point.x}%`}
                data-peak-date
              >
                {point.date}
              </span>
            ))
          }
        </div>

        <table class="sr-only">
          <caption>Contacts per day across peak week</caption>
          <thead>
            <tr>
              <th scope="col">Day</th>
              <th scope="col">Contacts</th>
              <th scope="col">Handed to a person</th>
            </tr>
          </thead>
          <tbody>
            {
              page.peak.days.map((day) => (
                <tr>
                  <th scope="row">{day.highlight ? `${day.date}, ${day.highlight}` : day.date}</th>
                  <td>{format(day.contacts)}</td>
                  <td>{format(day.handedOff)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </figure>
    </div>
  </section>

  <section class="pb-20 lg:pb-32" aria-labelledby="systems-title">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <h2 id="systems-title" class="reveal text-display-md"><Accent text={page.systems.title} /></h2>
        <p class="reveal mt-6 text-muted">{page.systems.lead}</p>
      </div>
      <div class="reveal lg:col-span-8">
        <div class="meta hidden grid-cols-[minmax(0,0.9fr)_minmax(0,1.3fr)_minmax(0,1.1fr)] gap-6 px-6 pb-3 sm:grid" aria-hidden="true">
          <span>System</span>
          <span>Reads</span>
          <span>Writes</span>
        </div>
        <dl class="grid gap-2">
          {
            page.systems.items.map((system) => (
              <div class="grid gap-x-6 gap-y-1 rounded-2xl bg-surface p-5 shadow-[inset_0_0_0_1px_var(--line)] sm:grid-cols-[minmax(0,0.9fr)_minmax(0,1.3fr)_minmax(0,1.1fr)] sm:px-6">
                <dt class="flex items-center gap-3 font-medium">
                  <span class="grid size-8 place-items-center rounded-lg bg-brand-soft text-brand"><Icon name={system.icon} class="size-4" /></span>
                  {system.name}
                </dt>
                <dd class="text-muted">
                  <span class="meta sm:hidden">Reads </span>
                  {system.reads}
                </dd>
                <dd class:list={[system.writes === "Nothing" ? "text-muted" : "text-ink"]}>
                  <span class="meta sm:hidden">Writes </span>
                  {system.writes}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {
    story && (
      <section class="pb-20 lg:pb-32" aria-label="Customer story">
        <div class="shell">
          <figure class="on-night pattern reveal grid gap-2 rounded-card p-3 [--glow:70%_90%_at_100%_0%] md:grid-cols-12">
            <div class="relative aspect-4/3 overflow-hidden rounded-[1.4rem] bg-sunken md:col-span-4 md:aspect-auto md:min-h-96">
              <Image
                src={story.photo}
                alt={`Portrait of ${story.name}`}
                widths={[360, 480]}
                sizes="(min-width: 768px) 33vw, 100vw"
                class="story-photo absolute inset-0 size-full object-cover"
                style={`object-position: ${story.focus ?? "50% 30%"}`}
              />
            </div>
            <div class="flex flex-col p-6 sm:p-10 md:col-span-8 lg:p-12">
              <CompanyLogo name={story.company} class="text-xl" />
              <blockquote class="mt-10 text-[clamp(1.35rem,1.05rem+1.1vw,2.05rem)] leading-[1.25] tracking-[-0.025em]">
                “{story.quote}”
              </blockquote>
              <figcaption class="mt-auto flex flex-wrap items-end justify-between gap-6 pt-12">
                <span>
                  <span class="block font-medium">{story.name}</span>
                  <span class="text-night-muted">
                    {story.role}, {story.company}
                  </span>
                </span>
                <span class="text-right">
                  <span class="block text-6xl leading-none font-medium tracking-tight text-spark">{story.result.value}</span>
                  <span class="text-sm text-night-muted">{story.result.label}</span>
                </span>
              </figcaption>
            </div>
          </figure>
        </div>
      </section>
    )
  }

  <Faq id={`${page.slug}-faq`} {...page.faq} />

  <section class="pb-20 sm:pb-28">
    <div class="shell">
      <div class="on-night pattern reveal relative mx-auto flex flex-col items-center overflow-hidden rounded-4xl [--glow:80%_90%_at_50%_0%] px-6 py-16 text-center sm:px-12 sm:py-24">
        <h2 class="relative max-w-3xl text-display-lg"><Accent text={page.closing.title} /></h2>
        <p class="relative mt-6 max-w-xl text-lead text-night-muted">{page.closing.body}</p>
        <div class="relative mt-10 flex flex-wrap justify-center gap-3">
          <a href={primary.href} class="btn btn-spark">
            {primary.label}
            <Icon name="arrow-right" class="btn-arrow" stroke={2} />
          </a>
          <a href="/pricing/" class="btn btn-ghost">See pricing</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .peak:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 8px;
  }

  .peak-date {
    transition: color 0.2s;
  }

  .peak-date[data-active] {
    color: var(--ink);
  }

  .is-visible .peak-draw {
    animation: draw 1.6s var(--ease-out-expo) 0.2s both;
  }

  @keyframes draw {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(-5% -1% -5% 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-visible .peak-draw {
      animation: none;
    }
  }
</style>

<script>
  interface Point {
    x: number;
    total: number;
    handoff: number;
    value: string;
    caption: string;
  }

  document.querySelectorAll<HTMLElement>("[data-peak]").forEach((root) => {
    const plotEl = root.querySelector<HTMLElement>("[data-peak-plot]")!;
    const points: Point[] = JSON.parse(plotEl.dataset.points ?? "[]");
    const cross = root.querySelector<HTMLElement>("[data-peak-cross]")!;
    const dotTotal = cross.querySelector<HTMLElement>('[data-peak-dot="total"]')!;
    const dotHandoff = cross.querySelector<HTMLElement>('[data-peak-dot="handoff"]')!;
    const dates = [...root.querySelectorAll<HTMLElement>("[data-peak-date]")];
    const value = root.querySelector<HTMLElement>("[data-peak-value]")!;
    const caption = root.querySelector<HTMLElement>("[data-peak-caption]")!;
    const initial = { value: value.textContent, caption: caption.textContent };
    let active = -1;

    const select = (index: number) => {
      active = index;
      const point = points[index];
      cross.hidden = !point;
      dates.forEach((date, i) => date.toggleAttribute("data-active", i === index));
      value.textContent = point ? point.value : initial.value;
      caption.textContent = point ? point.caption : initial.caption;
      if (!point) return;
      cross.style.left = `${point.x}%`;
      dotTotal.style.top = `${point.total}%`;
      dotHandoff.style.top = `${point.handoff}%`;
    };

    const fromPointer = (event: PointerEvent) => {
      const box = plotEl.getBoundingClientRect();
      const ratio = Math.min(1, Math.max(0, (event.clientX - box.left) / box.width));
      select(Math.round(ratio * (points.length - 1)));
    };

    plotEl.addEventListener("pointermove", fromPointer);
    plotEl.addEventListener("pointerdown", fromPointer);
    plotEl.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse") select(-1);
    });
    plotEl.addEventListener("keydown", (event) => {
      if (event.key === "Escape") return select(-1);
      const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
      if (!step) return;
      event.preventDefault();
      const from = active < 0 ? (step > 0 ? -1 : points.length) : active;
      select(Math.min(points.length - 1, Math.max(0, from + step)));
    });
    plotEl.addEventListener("blur", () => select(-1));
  });
</script>
