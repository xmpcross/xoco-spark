---
import Capabilities from "@/components/home/Capabilities.astro";
import Closing from "@/components/home/Closing.astro";
import Faq from "@/components/home/Faq.astro";
import Hero from "@/components/home/Hero.astro";
import Integrations from "@/components/home/Integrations.astro";
import LatestPosts from "@/components/home/LatestPosts.astro";
import LogoStrip from "@/components/home/LogoStrip.astro";
import Platform from "@/components/home/Platform.astro";
import Results from "@/components/home/Results.astro";
import Security from "@/components/home/Security.astro";
import Testimonials from "@/components/home/Testimonials.astro";
import Workflows from "@/components/home/Workflows.astro";
import { faq } from "@/config/home";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <Hero />
  <LogoStrip />
  <Workflows />
  <Capabilities />
  <Platform />
  <Results />
  <Integrations />
  <Testimonials />
  <Security />
  <Faq {...faq} />
  <LatestPosts />
  <Closing />
</BaseLayout>
