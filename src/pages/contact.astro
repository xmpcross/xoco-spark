---
import Accent from "@/components/ui/Accent.astro";
import Icon from "@/components/ui/Icon.astro";
import { contact } from "@/config/contact";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const live = siteConfig.contact.enabled && siteConfig.contact.action.trim() !== "";
const fieldClass =
  "h-12 w-full min-w-0 rounded-xl bg-page px-4 shadow-[inset_0_0_0_1px_var(--line)] outline-none transition-shadow placeholder:text-muted focus-visible:shadow-[inset_0_0_0_1.5px_var(--brand),0_0_0_4px_var(--brand-soft)] focus-visible:outline-none";
---

<BaseLayout title="Contact" description={contact.lead}>
  <section class="pattern -mt-(--header-h) pt-[calc(var(--header-h)+3rem)] pb-20 sm:pt-[calc(var(--header-h)+5rem)] lg:pb-28">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <h1 class="rise text-display-lg" style="--i:1"><Accent text={contact.title} /></h1>
        <p class="rise mt-6 text-lead text-muted" style="--i:2">{contact.lead}</p>

        <ol class="rise mt-10 grid gap-3" style="--i:3">
          {
            contact.steps.map((step, index) => (
              <li class="flex items-center gap-3.5">
                <span class="grid size-8 shrink-0 place-items-center rounded-full bg-ink text-sm font-semibold text-spark tabular">{index + 1}</span>
                {step}
              </li>
            ))
          }
        </ol>

        <h2 class="reveal mt-14 text-sm font-medium text-muted">{contact.routesTitle}</h2>
        <dl class="mt-4 grid gap-2 sm:grid-cols-2">
          {
            contact.routes.map((route) => (
              <div class="reveal rounded-2xl bg-surface p-4 shadow-[inset_0_0_0_1px_var(--line)]">
                <dt class="font-medium">{route.label}</dt>
                <dd class="mt-0.5 text-sm text-muted">{route.detail}</dd>
                <dd class="mt-2 text-sm">
                  <a href={`mailto:${route.email}`} class="link">
                    {route.email}
                  </a>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="rise lg:col-span-7" style="--i:2">
        <form
          class="grid gap-6 rounded-4xl bg-surface p-6 shadow-(--shadow-lift) ring-1 ring-line sm:p-10"
          action={live ? siteConfig.contact.action : undefined}
          method={siteConfig.contact.method}
          aria-describedby={live ? undefined : "contact-note"}
        >
          <p class="text-title">
            <label for="contact-topic">I’d like to</label>
            <span class="topic relative ml-1.5 inline-flex items-center">
              <select
                id="contact-topic"
                name="topic"
                class="topic-select appearance-none rounded-lg bg-brand-soft py-0.5 pr-9 pl-3 text-brand-ink outline-none focus-visible:outline-2 focus-visible:outline-brand"
                data-contact-topic
              >
                {contact.topics.map((topic) => <option value={topic.value}>{topic.label}</option>)}
              </select>
              <Icon name="chevron-down" class="pointer-events-none absolute right-2.5 size-5 text-brand" />
            </span>
          </p>

          <div class="grid gap-5 sm:grid-cols-2">
            <div class="grid gap-2">
              <label for="contact-name" class="text-sm font-medium">Name</label>
              <input id="contact-name" name="name" type="text" autocomplete="name" required class={fieldClass} />
            </div>
            <div class="grid gap-2">
              <label for="contact-email" class="text-sm font-medium">Work email</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="you@company.com"
                required
                class={fieldClass}
              />
            </div>
            <div class="grid gap-2">
              <label for="contact-company" class="text-sm font-medium">Company</label>
              <input id="contact-company" name="company" type="text" autocomplete="organization" class={fieldClass} />
            </div>
            <div class="grid gap-2">
              <label for="contact-size" class="text-sm font-medium">Support team size</label>
              <div class="relative">
                <select id="contact-size" name="team_size" class:list={[fieldClass, "appearance-none pr-10"]}>
                  <option value="">Choose one</option>
                  {contact.teamSizes.map((size) => <option>{size}</option>)}
                </select>
                <Icon name="chevron-down" class="pointer-events-none absolute top-1/2 right-4 size-4 -translate-y-1/2 text-muted" />
              </div>
            </div>
          </div>

          <div class="grid gap-2">
            <label for="contact-message" class="text-sm font-medium">Message</label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="Your channels, monthly volume, and what you would like Spark to handle first."
              class:list={[fieldClass, "h-auto resize-y py-3"]}></textarea>
          </div>

          <div class="grid gap-3">
            <button type="submit" class="btn btn-brand justify-self-start disabled:cursor-not-allowed disabled:opacity-60" disabled={!live}>
              Send message
              <Icon name="arrow-right" class="btn-arrow" stroke={2} />
            </button>
            {
              !live && (
                <p id="contact-note" class="text-sm text-muted">
                  The form is off in this preview. Connect a form endpoint in the site config to turn it on.
                </p>
              )
            }
          </div>
        </form>
      </div>
    </div>
  </section>

  <section class="pb-20 lg:pb-28" aria-labelledby="offices-title">
    <div class="shell">
      <h2 id="offices-title" class="reveal text-display-md"><Accent text={contact.officesTitle} /></h2>
      <ul class="mt-10 grid gap-4 sm:grid-cols-3">
        {
          contact.offices.map((office, index) => (
            <li class="reveal rounded-card bg-surface p-7 shadow-[inset_0_0_0_1px_var(--line)]" style={`--i:${index}`}>
              <span class="grid size-11 place-items-center rounded-xl bg-brand-soft text-brand">
                <Icon name="building-2" class="size-5" />
              </span>
              <h3 class="mt-6 text-xl font-medium tracking-tight">{office.city}</h3>
              <address class="mt-2 text-muted not-italic">
                {office.address.map((line) => (
                  <span class="block">{line}</span>
                ))}
              </address>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .topic-select {
    field-sizing: content;
    max-width: 100%;
    cursor: pointer;
  }

  .topic-select option {
    color: var(--ink);
    font-size: 1rem;
  }
</style>

<script>
  const topic = new URLSearchParams(window.location.search).get("topic");
  const select = document.querySelector<HTMLSelectElement>("[data-contact-topic]");
  if (select && topic && [...select.options].some((option) => option.value === topic)) select.value = topic;
</script>
