---
import { Image } from "astro:assets";
import TeamGlobe from "@/components/about/TeamGlobe.astro";
import Accent from "@/components/ui/Accent.astro";
import Icon from "@/components/ui/Icon.astro";
import { about } from "@/config/about";
import { careers } from "@/config/careers";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const { primary } = siteConfig.actions;
---

<BaseLayout title="About" description={about.lead}>
  <section class="pattern -mt-(--header-h) pt-[calc(var(--header-h)+3rem)] pb-14 sm:pt-[calc(var(--header-h)+5rem)]">
    <div class="shell text-center">
      <h1 class="rise mx-auto max-w-4xl text-display-xl" style="--i:1"><Accent text={about.title} /></h1>
      <p class="rise mx-auto mt-6 max-w-2xl text-lead text-muted" style="--i:2">{about.lead}</p>
      <div class="rise mt-9 flex flex-wrap justify-center gap-3" style="--i:3">
        <a href={about.closing.cta.href} class="btn btn-brand">
          {about.closing.cta.label}
          <Icon name="arrow-right" class="btn-arrow" stroke={2} />
        </a>
        <a href={primary.href} class="btn btn-ghost">{primary.label}</a>
      </div>
    </div>

    <div class="shell mt-14">
      <figure class="rise relative aspect-4/3 overflow-hidden rounded-card sm:aspect-video lg:aspect-21/9" style="--i:4">
        <Image
          src={about.photo}
          alt={about.photoAlt}
          widths={[640, 960, 1400, 2000]}
          sizes="(min-width: 1344px) 80rem, 100vw"
          loading="eager"
          class="absolute inset-0 size-full object-cover"
        />
        <div class="absolute right-4 bottom-4 left-4 flex flex-wrap gap-2 sm:right-auto sm:bottom-6 sm:left-6">
          {
            about.facts.slice(0, 2).map((fact) => (
              <span class="rounded-2xl bg-surface/90 px-4 py-2.5 text-sm shadow-(--shadow-float) backdrop-blur">
                <strong class="font-semibold">{fact.value}</strong> <span class="text-muted">{fact.label}</span>
              </span>
            ))
          }
        </div>
      </figure>
    </div>
  </section>

  <section class="py-20 lg:py-28" aria-labelledby="story-title">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-8">
      <h2 id="story-title" class="reveal text-display-md lg:col-span-4"><Accent text={about.story.title} /></h2>
      <div class="grid gap-6 lg:col-span-7 lg:col-start-6">
        {
          about.story.paragraphs.map((paragraph, i) => (
            <p class:list={["reveal", i === 0 ? "text-title" : "text-lead text-muted"]}>{paragraph}</p>
          ))
        }
      </div>
    </div>
  </section>

  <section class="shell" aria-label={`${siteConfig.name} in numbers`}>
    <dl class="on-night pattern grid grid-cols-2 gap-px overflow-hidden rounded-4xl lg:grid-cols-4">
      {
        about.facts.map((fact, index) => (
          <div class="reveal flex min-h-44 flex-col p-6 sm:min-h-52 sm:p-8 lg:min-h-60 lg:p-10" style={`--i:${index}`}>
            <dt class="order-2 mt-auto pt-8 text-night-muted">{fact.label}</dt>
            <dd class="order-1 text-[clamp(2.75rem,2rem+2.6vw,4.5rem)] leading-none font-medium tracking-[-0.04em] text-spark">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="py-20 lg:py-28" aria-labelledby="milestones-title">
    <div class="shell">
      <h2 id="milestones-title" class="reveal text-display-md"><Accent text={about.milestonesTitle} /></h2>
      <ol class="timeline mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-5">
        {
          about.milestones.map((milestone, i) => (
            <li class="reveal relative pt-9" style={`--i:${i}`}>
              <span
                class:list={[
                  "absolute top-0 left-0 grid size-5 place-items-center rounded-full",
                  i === about.milestones.length - 1 ? "bg-brand shadow-[0_0_0_6px_var(--brand-soft)]" : "bg-surface shadow-[inset_0_0_0_1.5px_var(--brand)]",
                ]}
                aria-hidden="true"
              />
              <span class="text-sm font-semibold text-brand tabular">{milestone.year}</span>
              <h3 class="mt-2 text-lg font-medium tracking-tight">{milestone.title}</h3>
              <p class="mt-2 text-muted">{milestone.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="pb-20 lg:pb-28" aria-labelledby="leadership-title">
    <div class="shell">
      <h2 id="leadership-title" class="reveal text-center text-display-md"><Accent text={about.leadershipTitle} /></h2>
      <ul class="mt-12 grid grid-cols-2 gap-4 lg:mt-16 lg:grid-cols-4">
        {
          about.leadership.map((person, index) => (
            <li class="reveal group rounded-card bg-surface p-2 shadow-[inset_0_0_0_1px_var(--line)]" style={`--i:${index}`}>
              <div class="relative aspect-4/5 overflow-hidden rounded-panel bg-sunken">
                <Image
                  src={person.photo}
                  alt={`Portrait of ${person.name}`}
                  widths={[320, 480, 720]}
                  sizes="(min-width: 1024px) 19rem, 50vw"
                  class="leader-photo absolute inset-0 size-full object-cover object-top"
                />
              </div>
              <div class="p-3 sm:p-4">
                <span class="block text-[1.05rem] font-medium">{person.name}</span>
                <span class="mt-0.5 block text-sm text-muted">{person.role}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <TeamGlobe />

  <section class="py-20 sm:py-28" aria-labelledby="join-title">
    <div class="shell">
      <div class="on-night pattern reveal relative grid overflow-hidden rounded-4xl [--glow:80%_90%_at_85%_10%] lg:grid-cols-12">
        <div class="relative px-6 py-14 sm:px-12 sm:py-20 lg:col-span-7 lg:pl-16">
          <h2 id="join-title" class="text-display-lg"><Accent text={about.closing.title} /></h2>
          <p class="mt-6 max-w-lg text-lead text-night-muted">{about.closing.body}</p>
          <a href={about.closing.cta.href} class="btn btn-spark mt-10">
            {about.closing.cta.label}
            <Icon name="arrow-right" class="btn-arrow" stroke={2} />
          </a>
        </div>
        <dl class="relative grid grid-cols-3 content-center gap-3 px-6 pb-12 sm:px-12 lg:col-span-5 lg:grid-cols-1 lg:py-16 lg:pr-16 lg:pl-0">
          {
            [{ value: String(careers.roles.length), label: "open roles" }, ...about.closing.proof].map((item) => (
              <div class="rounded-2xl bg-white/6 p-5 ring-1 ring-night-line">
                <dt class="order-2 text-sm text-night-muted">{item.label}</dt>
                <dd class="order-1 text-2xl font-medium tracking-tight sm:text-3xl">{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .timeline::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    margin-top: 0.6rem;
    border-top: 1.5px dashed color-mix(in srgb, var(--brand) 35%, transparent);
  }

  .timeline {
    position: relative;
  }

  @media (max-width: 63.99rem) {
    .timeline::before {
      display: none;
    }
  }

  .leader-photo {
    transition: transform 0.8s var(--ease-out-expo);
  }

  .group:hover .leader-photo {
    transform: scale(1.04);
  }
</style>
