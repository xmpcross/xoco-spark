{
  "name": "spark-astro-theme",
  "description": "An Astro theme for SaaS products: animated product workflows, a bento feature grid, product UI built in HTML and CSS, pricing, and a blog.",
  "type": "module",
  "version": "1.1.1",
  "author": "Andrei Alba",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "keywords": [
    "astro-theme",
    "astro",
    "saas",
    "ai",
    "startup",
    "landing-page",
    "marketing",
    "pricing",
    "blog",
    "product",
    "tailwindcss"
  ],
  "homepage": "https://spark.xocoweb.workers.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xocothemes/spark.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "covers": "node scripts/covers.mjs",
    "release:check": "npm run check && npm run build && npm run format:check",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "yaml": "^2.8.3"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "cobe": "^2.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
